<Window x:Class="MahodAI.Civil3D.Plugin.CivilDelivery.UI.QuantityExclusionDecisionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="אישור החרגת קבוצת כמות" Width="560" SizeToContent="Height"
        MinWidth="500" MinHeight="350" WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft" ShowInTaskbar="False"
        Background="#FFF0F2F5" Foreground="#FF1C2420"
        FontFamily="./Fonts/#Rubik, Segoe UI, Arial" FontSize="12.5" UseLayoutRounding="True">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="CivilDeliveryTheme.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <!-- Two rows (b20/b21, from the b19 live run: at 560x390 the save/cancel buttons were cut off). The Auto footer
       row is measured before the star row, so the approver, the validation text and the buttons keep their room at
       any window height while the content scrolls. The content is declared first, so Tab still goes reason ->
       approver -> buttons as before; the ScrollViewer is not a tab stop. SizeToContent opens the window with
       everything visible. -->
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Focusable="False" IsTabStop="False">
      <StackPanel>
        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
          <StackPanel>
            <TextBlock Text="קבוצת הכמות שתוחרג" Style="{StaticResource CardTitle}"/>
            <TextBlock x:Name="QuantitySummaryText" Style="{StaticResource SoftText}"
                       Margin="0,4,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>

        <TextBlock Text="סיבה הנדסית להחרגה (חובה)" Style="{StaticResource MutedText}" Margin="2,0,2,4"/>
        <TextBox x:Name="ReasonBox" MinHeight="100" AcceptsReturn="True" VerticalContentAlignment="Top"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 TextChanged="OnInputChanged"/>
        <TextBlock Style="{StaticResource MutedText}" Margin="2,6,2,0" TextWrapping="Wrap"
                   Text="הכמות לא תימחק: היא תישאר בראיות, ב-audit.json ובנספח הביקורת ב-Excel עם שרטוט, hash וידיות המקור."/>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="1" Margin="0,12,0,0">
      <DockPanel Margin="0,0,0,7">
        <TextBlock Text="מאשר" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
        <TextBox x:Name="ApproverBox" Margin="8,0,0,0" MinWidth="210"
                 TextChanged="OnInputChanged"/>
      </DockPanel>
      <TextBlock Style="{StaticResource MutedText}" Margin="2,0,2,8" TextWrapping="Wrap"
                 Text="השמירה תרשום זמן UTC וגרסת פרופיל, תעדכן את סריקת הבדיקה הפעילה ותבטל אומדן/ייצוא קודמים."/>
      <DockPanel LastChildFill="False">
        <TextBlock x:Name="ValidationText" DockPanel.Dock="Left"
                   Foreground="{StaticResource Warn}" VerticalAlignment="Center" TextWrapping="Wrap"/>
        <Button DockPanel.Dock="Right" Content="ביטול" Click="OnCancel" IsCancel="True" Margin="6,0,0,0"/>
        <Button x:Name="BtnSave" DockPanel.Dock="Right" Content="שמור החרגה" Margin="6,0,0,0"
                Click="OnSave" IsDefault="True" Style="{StaticResource PrimaryButton}"/>
      </DockPanel>
    </StackPanel>
  </Grid>
</Window>
