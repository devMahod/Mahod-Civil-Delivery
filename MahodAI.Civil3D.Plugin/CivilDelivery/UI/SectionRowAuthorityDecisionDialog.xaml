<Window x:Class="MahodAI.Civil3D.Plugin.CivilDelivery.UI.SectionRowAuthorityDecisionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prim="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="אישור מקור זכות דרך" Width="820" Height="470"
        MinWidth="700" MinHeight="400" WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft" ShowInTaskbar="False"
        Background="#FF141821" Foreground="#FFE6E9EF"
        FontFamily="Segoe UI" FontSize="12">
  <Window.Resources>
    <SolidColorBrush x:Key="Panel" Color="#FF1C2230"/>
    <SolidColorBrush x:Key="Line" Color="#FF2C3444"/>
    <SolidColorBrush x:Key="Accent" Color="#FF3B82F6"/>
    <SolidColorBrush x:Key="Muted" Color="#FF9AA4B2"/>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource Panel}"/>
      <Setter Property="Foreground" Value="#FFE6E9EF"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="Padding" Value="7,5"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="Margin" Value="6,0,0,0"/>
      <Setter Property="Background" Value="{StaticResource Panel}"/>
      <Setter Property="Foreground" Value="#FFE6E9EF"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3">
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ButtonSurface" Property="Background" Value="#FF242B38"/>
                <Setter Property="Foreground" Value="#FF9AA4B2"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#FF71A5FA"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#FF71A5FA"/>
                <Setter TargetName="ButtonSurface" Property="BorderThickness" Value="2"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="{x:Type prim:DataGridColumnHeader}">
      <Setter Property="Background" Value="#FF2F3644"/>
      <Setter Property="Foreground" Value="#FFE6E9EF"/>
      <Setter Property="Padding" Value="6,5"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="0,0,1,1"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="SourceIdentityText" TargetType="TextBlock">
      <Setter Property="FlowDirection" Value="LeftToRight"/>
      <Setter Property="TextAlignment" Value="Left"/>
      <Setter Property="Padding" Value="4,3"/>
      <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
    </Style>
  </Window.Resources>

  <DockPanel Margin="16">
    <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" Padding="11"
            BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4"
            Margin="0,0,0,12">
      <StackPanel>
        <TextBlock x:Name="SubjectTitle" FontSize="14" FontWeight="SemiBold"/>
        <TextBlock x:Name="SubjectDetail" Foreground="{StaticResource Muted}"
                   Margin="0,4,0,0" TextWrapping="Wrap"/>
        <TextBlock Foreground="#FFE0A44C" Margin="0,7,0,0" TextWrapping="Wrap"
                   Text="בחר/י רק מקור ROW מוסמך. האישור נשמר בפרופיל ומשמש את כל החתכים הרלוונטיים לאחר תכנון מחדש. הוא נחתם לפי SHA-256, נתיב ושרשרת XREF; מקורות אחרים לא ייכנסו למידות."/>
      </StackPanel>
    </Border>

    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <DockPanel Margin="0,0,0,9">
        <TextBlock Text="מאשר/ת:" VerticalAlignment="Center"/>
        <TextBox x:Name="ApproverBox" Margin="8,0,0,0" MinWidth="210"
                 TextChanged="OnInputChanged"/>
      </DockPanel>
      <DockPanel LastChildFill="False">
        <TextBlock x:Name="ValidationText" DockPanel.Dock="Left"
                   Foreground="#FFE0A44C" VerticalAlignment="Center" TextWrapping="Wrap"/>
        <Button DockPanel.Dock="Right" Content="ביטול" Click="OnCancel" IsCancel="True"/>
        <Button x:Name="BtnSave" DockPanel.Dock="Right" Content="אשר מקור ROW"
                Click="OnSave" IsDefault="True" Background="{StaticResource Accent}"
                Foreground="White" FontWeight="SemiBold"/>
      </DockPanel>
    </StackPanel>

    <DataGrid x:Name="SourcesGrid" AutoGenerateColumns="False" CanUserAddRows="False"
              IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
              Background="{StaticResource Panel}" Foreground="#FFE6E9EF"
              RowBackground="{StaticResource Panel}" AlternatingRowBackground="#FF202736"
              BorderBrush="{StaticResource Line}" SelectionChanged="OnInputChanged">
      <DataGrid.Columns>
        <DataGridTextColumn Header="SHA-256" Binding="{Binding Hash}" Width="175" ElementStyle="{StaticResource SourceIdentityText}"/>
        <DataGridTextColumn Header="קובץ מקור" Binding="{Binding Path}" Width="*" ElementStyle="{StaticResource SourceIdentityText}"/>
        <DataGridTextColumn Header="שרשרת XREF" Binding="{Binding Xref}" Width="180" ElementStyle="{StaticResource SourceIdentityText}"/>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
