<Window x:Class="MahodAI.Civil3D.Plugin.CivilDelivery.UI.SectionRowAuthorityDecisionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prim="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="אישור מקור זכות דרך" Width="820" Height="470"
        MinWidth="700" MinHeight="400" WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft" ShowInTaskbar="False"
        Background="#FFF0F2F5" Foreground="#FF1C2420"
        FontFamily="./Fonts/#Rubik, Segoe UI, Arial" FontSize="12.5" UseLayoutRounding="True">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="CivilDeliveryTheme.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="SourceIdentityText" TargetType="TextBlock">
        <Setter Property="FlowDirection" Value="LeftToRight"/>
        <Setter Property="TextAlignment" Value="Left"/>
        <Setter Property="Padding" Value="4,3"/>
        <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
      </Style>
    </ResourceDictionary>
  </Window.Resources>

  <DockPanel Margin="16">
    <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,10">
      <StackPanel>
        <TextBlock x:Name="SubjectTitle" Style="{StaticResource CardTitle}"/>
        <TextBlock x:Name="SubjectDetail" Style="{StaticResource SoftText}"
                   Margin="0,4,0,0" TextWrapping="Wrap"/>
        <TextBlock Foreground="{StaticResource Warn}" Margin="0,7,0,0" TextWrapping="Wrap"
                   Text="בחר/י רק מקור ROW מוסמך. האישור נשמר בפרופיל ומשמש את כל החתכים הרלוונטיים לאחר תכנון מחדש. הוא נחתם לפי SHA-256, נתיב ושרשרת XREF; מקורות אחרים לא ייכנסו למידות."/>
      </StackPanel>
    </Border>

    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <DockPanel Margin="0,0,0,9">
        <TextBlock Text="מאשר/ת" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
        <TextBox x:Name="ApproverBox" Margin="8,0,0,0" MinWidth="210"
                 TextChanged="OnInputChanged"/>
      </DockPanel>
      <DockPanel LastChildFill="False">
        <TextBlock x:Name="ValidationText" DockPanel.Dock="Left"
                   Foreground="{StaticResource Warn}" VerticalAlignment="Center" TextWrapping="Wrap"/>
        <Button DockPanel.Dock="Right" Content="ביטול" Click="OnCancel" IsCancel="True" Margin="6,0,0,0"/>
        <Button x:Name="BtnSave" DockPanel.Dock="Right" Content="אשר מקור ROW" Margin="6,0,0,0"
                Click="OnSave" IsDefault="True" Style="{StaticResource PrimaryButton}"/>
      </DockPanel>
    </StackPanel>

    <Border Style="{StaticResource Card}" Padding="6">
    <DataGrid x:Name="SourcesGrid" AutoGenerateColumns="False" CanUserAddRows="False"
              IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column" BorderThickness="0"
              SelectionChanged="OnInputChanged">
      <DataGrid.Columns>
        <DataGridTextColumn Header="SHA-256" Binding="{Binding Hash}" Width="175" ElementStyle="{StaticResource SourceIdentityText}"/>
        <DataGridTextColumn Header="קובץ מקור" Binding="{Binding Path}" Width="*" ElementStyle="{StaticResource SourceIdentityText}"/>
        <DataGridTextColumn Header="שרשרת XREF" Binding="{Binding Xref}" Width="180" ElementStyle="{StaticResource SourceIdentityText}"/>
      </DataGrid.Columns>
    </DataGrid>
    </Border>
  </DockPanel>
</Window>
