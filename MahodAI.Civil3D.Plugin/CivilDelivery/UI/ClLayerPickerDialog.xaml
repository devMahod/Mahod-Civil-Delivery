<Window x:Class="MahodAI.Civil3D.Plugin.CivilDelivery.UI.ClLayerPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="בחירת שכבת קווי חתך"
        Width="720" Height="520" MinWidth="600" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="#FFF0F2F5" Foreground="#FF1C2420"
        FontFamily="./Fonts/#Rubik, Segoe UI, Arial" FontSize="12.5" UseLayoutRounding="True"
        ShowInTaskbar="False">

  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="CivilDeliveryTheme.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <DockPanel Margin="16">

    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
      <TextBlock x:Name="FileTitle" Style="{StaticResource DialogTitle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
      <TextBlock x:Name="ScanSummary" Style="{StaticResource MutedText}" Margin="0,3,0,0" TextWrapping="Wrap"/>
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
      <Button Content="ביטול" IsCancel="True" Click="OnCancel" Margin="6,0,0,0"/>
      <Button x:Name="BtnOk" Content="אישור" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnOk" Margin="6,0,0,0"/>
    </StackPanel>

    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource MutedText}" Margin="2,8,2,0" TextWrapping="Wrap"
               Text="הדירוג מבוסס על ראיות מהשרטוט בלבד — כמה קווים ישרים יש בשכבה, כמה מהם באמת חוצים תוואי תכנון, ומה האורך האופייני. הבחירה שלך, והיא נשמרת לפרויקט."/>

    <Border Style="{StaticResource Card}" Padding="6">
      <ListView x:Name="Candidates" SelectionMode="Single" MouseDoubleClick="OnRowDoubleClick">
        <ListView.ItemTemplate>
          <DataTemplate>
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Layer}" FontWeight="SemiBold" FontSize="14"/>
                <TextBlock Text="{Binding ScoreDisplay}" Foreground="{StaticResource AccentInk}" Margin="10,0,0,0" FontSize="12.5"/>
              </StackPanel>
              <TextBlock Text="{Binding Evidence}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
            </StackPanel>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
    </Border>

  </DockPanel>
</Window>
