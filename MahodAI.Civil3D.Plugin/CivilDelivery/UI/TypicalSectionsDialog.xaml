<Window x:Class="MahodAI.Civil3D.Plugin.CivilDelivery.UI.TypicalSectionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="חתכים טיפוסיים"
        Width="600" SizeToContent="Height" MaxHeight="740" MinWidth="460" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="#FFF0F2F5" Foreground="#FF1C2420"
        FontFamily="./Fonts/#Rubik, Segoe UI, Arial" FontSize="13" UseLayoutRounding="True"
        ShowInTaskbar="False">

  <!-- Typical sections (2026-10): one popup for the whole flow. Review before creating (every mark, remove one,
       add more), the result after (numbers, every section with "show"), or what is missing when the run stopped.
       The house look: grey canvas, white rounded cards that grow a little on hover, one ink, outline icons in one
       colour, green only for a good result. -->

  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="CivilDeliveryTheme.xaml"/>
      </ResourceDictionary.MergedDictionaries>

      <Style x:Key="StatLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
      </Style>
      <Style x:Key="StatNumber" TargetType="TextBlock">
        <Setter Property="FontSize" Value="30"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="Margin" Value="0,6,0,0"/>
      </Style>
      <Style x:Key="IconChip" TargetType="Border">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="CornerRadius" Value="11"/>
        <Setter Property="Background" Value="{StaticResource IconBg}"/>
      </Style>
      <Style x:Key="ChipIcon" TargetType="Path">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="StrokeThickness" Value="1.8"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="Stroke" Value="{StaticResource IconInk}"/>
        <Setter Property="FlowDirection" Value="LeftToRight"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
      </Style>
      <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="MinWidth" Value="60"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
      </Style>
    </ResourceDictionary>
  </Window.Resources>

  <Window.Triggers>
    <EventTrigger RoutedEvent="Window.Loaded">
      <BeginStoryboard>
        <Storyboard>
          <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22"/>
          <DoubleAnimation Storyboard.TargetName="RootShift" Storyboard.TargetProperty="Y" From="14" To="0" Duration="0:0:0.30">
            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
          </DoubleAnimation>
        </Storyboard>
      </BeginStoryboard>
    </EventTrigger>
  </Window.Triggers>

  <DockPanel x:Name="Root" Margin="20,18,20,16">
    <DockPanel.RenderTransform><TranslateTransform x:Name="RootShift"/></DockPanel.RenderTransform>

    <!-- head: one chip, one title, one short line -->
    <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border x:Name="HeadChip" Width="44" Height="44" CornerRadius="15" Background="{StaticResource Panel}" Margin="0,0,0,0">
        <Path x:Name="HeadIcon" Style="{StaticResource ChipIcon}" Width="20" Height="20" Stroke="{StaticResource Ink}"
              Data="{StaticResource IconMapPin}"/>
      </Border>
      <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
        <TextBlock x:Name="HeadTitle" Text="8 חתכים מוכנים ליצירה" FontSize="19" FontWeight="Medium" TextWrapping="Wrap"/>
        <TextBlock x:Name="HeadSub" Text="Road34 · חצי רוחב 20 מ'" Style="{StaticResource MutedText}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
      </StackPanel>
    </Grid>

    <!-- actions -->
    <WrapPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
      <Button x:Name="BtnCreate" Content="צור 8 חתכים" Style="{StaticResource PrimaryButton}" Tag="check" IsDefault="True" Click="OnCreate" MinWidth="140"/>
      <Button x:Name="BtnAddMore" Content="סמן עוד" Tag="pin" Click="OnAddMore"/>
      <Button x:Name="BtnFolder" Content="תיקיית הריצה" Tag="folder" Click="OnOpenFolder" Visibility="Collapsed"/>
      <Button x:Name="BtnClose" Content="ביטול" IsCancel="True" Click="OnClose"/>
    </WrapPanel>

    <!-- the numbers: three cards in one row -->
    <UniformGrid x:Name="Stats" DockPanel.Dock="Top" Columns="3" Margin="0,0,0,14">
      <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,0" CornerRadius="18" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
        <Border.Triggers>
          <EventTrigger RoutedEvent="Mouse.MouseEnter"><BeginStoryboard><Storyboard>
            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.03" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.03" Duration="0:0:0.2"/>
          </Storyboard></BeginStoryboard></EventTrigger>
          <EventTrigger RoutedEvent="Mouse.MouseLeave"><BeginStoryboard><Storyboard>
            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.2"/>
          </Storyboard></BeginStoryboard></EventTrigger>
        </Border.Triggers>
        <StackPanel>
          <DockPanel>
            <Border DockPanel.Dock="Right" Style="{StaticResource IconChip}">
              <Path x:Name="StatIcon1" Style="{StaticResource ChipIcon}" Data="{StaticResource IconMapPin}"/>
            </Border>
            <TextBlock x:Name="StatLabel1" Text="חתכים" Style="{StaticResource StatLabel}"/>
          </DockPanel>
          <TextBlock x:Name="StatValue1" Text="8" Style="{StaticResource StatNumber}"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Padding="16,14" Margin="12,0,0,0" CornerRadius="18" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
        <Border.Triggers>
          <EventTrigger RoutedEvent="Mouse.MouseEnter"><BeginStoryboard><Storyboard>
            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.03" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.03" Duration="0:0:0.2"/>
          </Storyboard></BeginStoryboard></EventTrigger>
          <EventTrigger RoutedEvent="Mouse.MouseLeave"><BeginStoryboard><Storyboard>
            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.2"/>
          </Storyboard></BeginStoryboard></EventTrigger>
        </Border.Triggers>
        <StackPanel>
          <DockPanel>
            <Border DockPanel.Dock="Right" Style="{StaticResource IconChip}">
              <Path x:Name="StatIcon2" Style="{StaticResource ChipIcon}" Data="{StaticResource IconRoute}"/>
            </Border>
            <TextBlock x:Name="StatLabel2" Text="תוואים" Style="{StaticResource StatLabel}"/>
          </DockPanel>
          <TextBlock x:Name="StatValue2" Text="1" Style="{StaticResource StatNumber}"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Padding="16,14" Margin="12,0,0,0" CornerRadius="18" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
        <Border.Triggers>
          <EventTrigger RoutedEvent="Mouse.MouseEnter"><BeginStoryboard><Storyboard>
            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.03" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.03" Duration="0:0:0.2"/>
          </Storyboard></BeginStoryboard></EventTrigger>
          <EventTrigger RoutedEvent="Mouse.MouseLeave"><BeginStoryboard><Storyboard>
            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.2"/>
          </Storyboard></BeginStoryboard></EventTrigger>
        </Border.Triggers>
        <StackPanel>
          <DockPanel>
            <Border DockPanel.Dock="Right" Style="{StaticResource IconChip}">
              <Path x:Name="StatIcon3" Style="{StaticResource ChipIcon}" Data="{StaticResource IconRuler}"/>
            </Border>
            <TextBlock x:Name="StatLabel3" Text="רוחב חתך" Style="{StaticResource StatLabel}"/>
          </DockPanel>
          <TextBlock x:Name="StatValue3" Text="40 מ'" Style="{StaticResource StatNumber}"/>
        </StackPanel>
      </Border>
    </UniformGrid>

    <!-- notes of a finished run, folded -->
    <Expander x:Name="NotesExpander" DockPanel.Dock="Bottom" Header="הערות" Margin="0,10,0,0" Visibility="Collapsed">
      <Border Style="{StaticResource InsetCard}" Margin="0,6,0,0">
        <ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <TextBlock x:Name="NotesText" Style="{StaticResource SoftText}" TextWrapping="Wrap"/>
        </ScrollViewer>
      </Border>
    </Expander>

    <!-- the list: the marks (review), the created sections (result), or what is missing (blocked) -->
    <Border Style="{StaticResource Card}" CornerRadius="18" Padding="6,6">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>

          <ItemsControl x:Name="PickList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border x:Name="Row" CornerRadius="12" Padding="10,8" Margin="2" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                  <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                  <Border.Triggers>
                    <EventTrigger RoutedEvent="Mouse.MouseEnter"><BeginStoryboard><Storyboard>
                      <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.015" Duration="0:0:0.2"/>
                      <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.015" Duration="0:0:0.2"/>
                    </Storyboard></BeginStoryboard></EventTrigger>
                    <EventTrigger RoutedEvent="Mouse.MouseLeave"><BeginStoryboard><Storyboard>
                      <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.2"/>
                      <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.2"/>
                    </Storyboard></BeginStoryboard></EventTrigger>
                  </Border.Triggers>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconChip}">
                      <TextBlock Text="{Binding Number}" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource Ink}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Station}" FontSize="15.5" FontWeight="SemiBold" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                      <TextBlock Text="{Binding Alignment}" Style="{StaticResource MutedText}" Margin="0,1,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="הסר" Tag="x" Style="{StaticResource RowButton}" Click="OnRemovePick"/>
                  </Grid>
                </Border>
                <DataTemplate.Triggers>
                  <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource Hover}"/>
                  </Trigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <ItemsControl x:Name="SectionList" Visibility="Collapsed">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border x:Name="Row" CornerRadius="12" Padding="10,8" Margin="2" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                  <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                  <Border.Triggers>
                    <EventTrigger RoutedEvent="Mouse.MouseEnter"><BeginStoryboard><Storyboard>
                      <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.015" Duration="0:0:0.2"/>
                      <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.015" Duration="0:0:0.2"/>
                    </Storyboard></BeginStoryboard></EventTrigger>
                    <EventTrigger RoutedEvent="Mouse.MouseLeave"><BeginStoryboard><Storyboard>
                      <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.2"/>
                      <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.2"/>
                    </Storyboard></BeginStoryboard></EventTrigger>
                  </Border.Triggers>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="Chip" Style="{StaticResource IconChip}">
                      <Path x:Name="ChipPath" Style="{StaticResource ChipIcon}" Data="{StaticResource IconCheck}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                 FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                      <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button x:Name="ShowButton" Grid.Column="2" Content="הצג" Tag="locate" Style="{StaticResource RowButton}" Click="OnShowSection"/>
                  </Grid>
                </Border>
                <DataTemplate.Triggers>
                  <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource Hover}"/>
                  </Trigger>
                  <DataTrigger Binding="{Binding Good}" Value="True">
                    <Setter TargetName="Chip" Property="Background" Value="{StaticResource AccentTint}"/>
                    <Setter TargetName="ChipPath" Property="Stroke" Value="{StaticResource AccentInk}"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Good}" Value="False">
                    <Setter TargetName="ChipPath" Property="Data" Value="{StaticResource IconLayers}"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding CanShow}" Value="False">
                    <Setter TargetName="ShowButton" Property="Visibility" Value="Collapsed"/>
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <ItemsControl x:Name="BlockerList" Visibility="Collapsed">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border CornerRadius="12" Padding="10,9" Margin="2">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconChip}" Background="{StaticResource BlockedTint}" VerticalAlignment="Top">
                      <Path Style="{StaticResource ChipIcon}" Stroke="{StaticResource Blocked}" Data="{StaticResource IconX}"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding}" Margin="12,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="13"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

        </Grid>
      </ScrollViewer>
    </Border>

  </DockPanel>
</Window>
