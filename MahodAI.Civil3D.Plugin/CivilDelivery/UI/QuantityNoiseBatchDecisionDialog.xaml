<Window x:Class="MahodAI.Civil3D.Plugin.CivilDelivery.UI.QuantityNoiseBatchDecisionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="אישור מרוכז — סימוני תחנות ועזר" Width="940" Height="680"
        MinWidth="760" MinHeight="520" WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft" ShowInTaskbar="False"
        Background="#FFF0F2F5" Foreground="#FF1C2420"
        FontFamily="./Fonts/#Rubik, Segoe UI, Arial" FontSize="12.5" UseLayoutRounding="True">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="CivilDeliveryTheme.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="בדיקה מרוכזת של רעש שרטוט" Style="{StaticResource DialogTitle}"/>
      <TextBlock x:Name="SummaryText" Style="{StaticResource MutedText}"
                 Margin="0,4,0,10" TextWrapping="Wrap"/>
      <Border Background="{StaticResource ReviewTint}" Padding="12,9" CornerRadius="12" Margin="0,0,0,10">
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Ink}"
                   Text="ברשימה מופיעות רק קבוצות שהמסווג קבע כסימוני תחנות או כעזר גרפי. תשתיות קיימות, מדידות בהיקף חריג, קבוצות ממופות וכמויות בנייה אינן נכללות. ההחרגה אינה מוחקת מדידה: כל קבוצה נשארת בראיות וב-audit עם המפתח, הכמות, הסיבה, המאשר והזמן."/>
      </Border>
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <CheckBox x:Name="ConfirmBox" Margin="2,0,2,10"
                Checked="OnInputChanged" Unchecked="OnInputChanged">
        <TextBlock TextWrapping="Wrap"
                   Text="בדקתי את הרשימה ואני מאשר לסמן את כל הקבוצות המוצגות כלא־רלוונטיות לאומדן המתומחר."/>
      </CheckBox>
      <DockPanel Margin="0,0,0,8">
        <TextBlock Text="מאשר" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
        <TextBox x:Name="ApproverBox" Margin="8,0,0,0" MinWidth="240"
                 TextChanged="OnInputChanged"/>
      </DockPanel>
      <DockPanel LastChildFill="False">
        <TextBlock x:Name="ValidationText" DockPanel.Dock="Left"
                   Foreground="{StaticResource Warn}" VerticalAlignment="Center" TextWrapping="Wrap"/>
        <Button DockPanel.Dock="Right" Content="ביטול" Click="OnCancel" IsCancel="True" Margin="6,0,0,0"/>
        <Button x:Name="BtnSave" DockPanel.Dock="Right" Content="אשר ושמור את הרשימה" Margin="6,0,0,0"
                Click="OnSave" IsDefault="True" Style="{StaticResource PrimaryButton}"/>
      </DockPanel>
    </StackPanel>

    <Border Style="{StaticResource Card}" Padding="6">
    <DataGrid x:Name="CandidatesGrid" AutoGenerateColumns="False" IsReadOnly="True"
              CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
              HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0">
      <DataGrid.Columns>
        <DataGridTextColumn Header="שכבה / מקור" Binding="{Binding Source}" Width="2*" MinWidth="180"
                            ElementStyle="{StaticResource CellText}"/>
        <DataGridTextColumn Header="סוג" Binding="{Binding EntityType}" Width="90"
                            ElementStyle="{StaticResource LtrCellText}"/>
        <DataGridTextColumn Header="כמות" Binding="{Binding QuantityDisplay}" Width="115"
                            ElementStyle="{StaticResource LtrCellText}"/>
        <DataGridTextColumn Header="סיבת הסיווג" Binding="{Binding SignificanceReason}" Width="2*" MinWidth="220"
                            ElementStyle="{StaticResource CellText}"/>
        <DataGridTextColumn Header="מפתח מדויק" Binding="{Binding RuleKey}" Width="2*" MinWidth="220"
                            ElementStyle="{StaticResource LtrCellText}"/>
      </DataGrid.Columns>
    </DataGrid>
    </Border>
  </DockPanel>
</Window>
