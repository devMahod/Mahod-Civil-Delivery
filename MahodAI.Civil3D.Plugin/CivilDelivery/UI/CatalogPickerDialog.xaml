<Window x:Class="MahodAI.Civil3D.Plugin.CivilDelivery.UI.CatalogPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="שיוך שכבה לסעיף מחירון"
        Width="760" Height="620" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="#FF141821" Foreground="#FFE6E9EF"
        FontFamily="Segoe UI" FontSize="12"
        ShowInTaskbar="False">

  <Window.Resources>
    <SolidColorBrush x:Key="Panel"  Color="#FF1C2230"/>
    <SolidColorBrush x:Key="Line"   Color="#FF2C3444"/>
    <SolidColorBrush x:Key="Accent" Color="#FF3B82F6"/>
    <SolidColorBrush x:Key="Muted"  Color="#FF9AA4B2"/>
    <SolidColorBrush x:Key="Ok"     Color="#FF22C55E"/>
    <SolidColorBrush x:Key="Warn"   Color="#FFE0A44C"/>

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource Panel}"/>
      <Setter Property="Foreground" Value="#FFE6E9EF"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="16,7"/>
      <Setter Property="Margin" Value="6,0,0,0"/>
      <Setter Property="Background" Value="{StaticResource Panel}"/>
      <Setter Property="Foreground" Value="#FFE6E9EF"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.65"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource Accent}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="{StaticResource Panel}"/>
      <Setter Property="Foreground" Value="#FFE6E9EF"/>
      <Setter Property="RowBackground" Value="{StaticResource Panel}"/>
      <Setter Property="AlternatingRowBackground" Value="#FF202736"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="GridLinesVisibility" Value="Horizontal"/>
      <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Line}"/>
      <Setter Property="AutoGenerateColumns" Value="False"/>
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="SelectionMode" Value="Single"/>
      <Setter Property="HeadersVisibility" Value="Column"/>
      <Setter Property="CanUserAddRows" Value="False"/>
      <Setter Property="MinRowHeight" Value="34"/>
    </Style>
    <Style x:Key="WrappedCellText" TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="5,3"/>
    </Style>
    <Style x:Key="LtrCellText" TargetType="TextBlock">
      <Setter Property="FlowDirection" Value="LeftToRight"/>
      <Setter Property="Margin" Value="5,3"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#FF202736"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="0,0,1,1"/>
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="6,2"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#FF2B4A7A"/>
          <Setter Property="Foreground" Value="White"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <DockPanel Margin="14">

    <!-- What is being mapped -->
    <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" Padding="12,10"
            BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,10">
      <StackPanel>
        <TextBlock x:Name="SubjectTitle" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock x:Name="SubjectDetail" Foreground="{StaticResource Muted}" Margin="0,3,0,0" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>

    <!-- Search -->
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <TextBlock DockPanel.Dock="Right" x:Name="ResultCount" Foreground="{StaticResource Muted}"
                 VerticalAlignment="Center" Margin="10,0,0,0"/>
      <TextBox x:Name="SearchBox" TextChanged="OnSearchChanged"
               ToolTip="חפש לפי מילים בעברית (למשל: אבן שפה) או לפי מס' סעיף (למשל: 51.01)"/>
    </DockPanel>
    <TextBlock DockPanel.Dock="Top" x:Name="Hint" Foreground="{StaticResource Muted}" Margin="0,0,0,6" TextWrapping="Wrap"
               Text="הצעות מהקטלוג מופיעות ראשונות. אפשר להקליד כדי לחפש בכל המחירון — לפי תיאור או לפי מס' סעיף."/>

    <!-- Buttons -->
    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <TextBlock x:Name="UnitVerdict" Margin="0,0,0,6" TextWrapping="Wrap"
                 Foreground="{StaticResource Muted}"/>
      <DockPanel LastChildFill="False">
      <Button DockPanel.Dock="Right" Content="ביטול" Click="OnCancel" IsCancel="True"/>
      <Button DockPanel.Dock="Right" x:Name="BtnOk" Content="אשר שיוך" Click="OnOk"
              Style="{StaticResource PrimaryButton}" IsDefault="True" IsEnabled="False"/>
      </DockPanel>
    </StackPanel>

    <!-- Candidates -->
    <DataGrid x:Name="Grid" SelectionChanged="OnSelectionChanged" MouseDoubleClick="OnRowDoubleClick"
              ScrollViewer.HorizontalScrollBarVisibility="Auto">
      <DataGrid.Columns>
        <DataGridTextColumn Header="סעיף"   Binding="{Binding Code}"        Width="110" MinWidth="110" ElementStyle="{StaticResource LtrCellText}"/>
        <DataGridTextColumn Header="תיאור"  Binding="{Binding Description}" Width="*" MinWidth="210" ElementStyle="{StaticResource WrappedCellText}"/>
        <DataGridTextColumn Header="יחידה"  Binding="{Binding Unit}"        Width="70" MinWidth="70"/>
        <DataGridTextColumn Header="מחיר"   Binding="{Binding PriceDisplay}" Width="90" MinWidth="90" ElementStyle="{StaticResource LtrCellText}"/>
        <DataGridTextColumn Header="מקור"   Binding="{Binding Why}"         Width="120" MinWidth="120" ElementStyle="{StaticResource WrappedCellText}"/>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
