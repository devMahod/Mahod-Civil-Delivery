<Window x:Class="MahodAI.Civil3D.Plugin.CivilDelivery.UI.CatalogPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="שיוך שכבה לסעיף מחירון"
        Width="980" Height="740" MinWidth="760" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="#FFF0F2F5" Foreground="#FF1C2420"
        FontFamily="./Fonts/#Rubik, Segoe UI, Arial" FontSize="12.5" UseLayoutRounding="True"
        ShowInTaskbar="False">

  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="CivilDeliveryTheme.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <DockPanel Margin="16">

    <!-- What is being mapped -->
    <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,10">
      <StackPanel>
        <TextBlock x:Name="SubjectTitle" Style="{StaticResource CardTitle}" TextWrapping="Wrap"/>
        <TextBlock x:Name="SubjectDetail" Style="{StaticResource SoftText}" Margin="0,4,0,0" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>

    <!-- Search -->
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <TextBlock DockPanel.Dock="Right" x:Name="ResultCount" Style="{StaticResource MutedText}"
                 VerticalAlignment="Center" Margin="10,0,0,0"/>
      <Button DockPanel.Dock="Left" Content="נקה" Style="{StaticResource QuietButton}" Click="OnClearSearch" Margin="0,0,6,0"/>
      <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" Tag="אבן שפה, פירוק אספלט, 51.01…" TextChanged="OnSearchChanged" FontSize="14" MinHeight="38"
               ToolTip="חפש לפי מילים בעברית (למשל: אבן שפה) או לפי מס' סעיף (למשל: 51.01)"/>
    </DockPanel>
    <TextBlock DockPanel.Dock="Top" x:Name="Hint" Style="{StaticResource MutedText}" Margin="2,0,2,6" TextWrapping="Wrap"
               Text="מה ראית בשרטוט? הקלד מילים כמו אבן שפה, פירוק אספלט או סימון לבן. סדר המילים לא משנה. בחר תוצאה ובדוק את התיאור המלא לפני אישור השיוך."/>
    <CheckBox DockPanel.Dock="Top" x:Name="CompatibleOnly" Content="הצג רק סעיפים ביחידת המדידה של השכבה"
              Margin="2,4,2,10" Checked="OnUnitFilterChanged" Unchecked="OnUnitFilterChanged"/>

    <!-- Buttons -->
    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <Border Style="{StaticResource Card}" Margin="0,0,0,8">
        <ScrollViewer MaxHeight="155" VerticalScrollBarVisibility="Auto">
          <TextBlock x:Name="SelectedDetail" Text="בחר סעיף מהרשימה כדי לראות תיאור מלא, יחידה ומחיר."
                     FontSize="13.5" TextWrapping="Wrap"/>
        </ScrollViewer>
      </Border>
      <TextBlock x:Name="UnitVerdict" Margin="2,0,2,6" TextWrapping="Wrap"
                 Style="{StaticResource MutedText}"/>
      <DockPanel LastChildFill="False">
      <Button DockPanel.Dock="Right" Content="ביטול" Click="OnCancel" IsCancel="True" Margin="6,0,0,0"/>
      <Button DockPanel.Dock="Right" x:Name="BtnOk" Content="אשר שיוך" Click="OnOk" Margin="6,0,0,0"
              Style="{StaticResource PrimaryButton}" IsDefault="True" IsEnabled="False"/>
      </DockPanel>
    </StackPanel>

    <!-- Candidates -->
    <Border Style="{StaticResource Card}" Padding="6">
    <DataGrid x:Name="Grid" SelectionChanged="OnSelectionChanged" MouseDoubleClick="OnRowDoubleClick"
              RowHeight="NaN" MinRowHeight="34" BorderThickness="0"
              ScrollViewer.HorizontalScrollBarVisibility="Auto">
      <DataGrid.Columns>
        <DataGridTextColumn Header="סעיף"   Binding="{Binding Code}"        Width="110" MinWidth="110" ElementStyle="{StaticResource LtrCellText}"/>
        <DataGridTextColumn Header="תיאור"  Binding="{Binding Description}" Width="*" MinWidth="210" ElementStyle="{StaticResource WrappedCellText}"/>
        <DataGridTextColumn Header="יחידה"  Binding="{Binding Unit}"        Width="70" MinWidth="70"/>
        <DataGridTextColumn Header="מחיר"   Binding="{Binding PriceDisplay}" Width="90" MinWidth="90" ElementStyle="{StaticResource LtrCellText}"/>
        <DataGridTextColumn Header="מקור"   Binding="{Binding Why}"         Width="120" MinWidth="120" ElementStyle="{StaticResource WrappedCellText}"/>
      </DataGrid.Columns>
    </DataGrid>
    </Border>
  </DockPanel>
</Window>
