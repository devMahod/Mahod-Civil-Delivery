<Window x:Class="MahodAI.Civil3D.Plugin.CivilDelivery.UI.EstimateSourceReviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MahodAI.Civil3D.Plugin.CivilDelivery.UI"
        Title="אישור מקורות האומדן" Width="940" Height="760"
        MinWidth="580" MinHeight="560" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FlowDirection="RightToLeft" Background="#FF141821" Foreground="#FFE6E9EF"
        FontFamily="Segoe UI" FontSize="13">
  <Window.Resources>
    <local:SourceGroupCheckConverter x:Key="GroupCheck"/>
    <SolidColorBrush x:Key="Panel" Color="#FF1C2230"/>
    <SolidColorBrush x:Key="Line" Color="#FF2C3444"/>
    <SolidColorBrush x:Key="Accent" Color="#FF3B82F6"/>
    <SolidColorBrush x:Key="Muted" Color="#FF9AA4B2"/>
    <Style TargetType="DataGridCell">
      <Setter Property="Foreground" Value="#FFE6E9EF"/>
      <Setter Property="Background" Value="{StaticResource Panel}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="5"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="16,9"/>
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="Margin" Value="8,0,0,0"/>
      <Setter Property="Background" Value="{StaticResource Panel}"/>
      <Setter Property="Foreground" Value="#FFE6E9EF"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource Accent}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
  </Window.Resources>

  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock Text="אישור מקורות האומדן" FontSize="21" FontWeight="SemiBold"/>
      <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource Muted}"
                 Text="בחר קבצים וקטגוריות לפני המדידה. הסיווג לפי שם הוא הצעה בלבד; אפשר לשנות אותו בלי לשנות את הסימון."/>
    </StackPanel>

    <Grid Grid.Row="1" Margin="0,8,0,6">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock Text="רשימת המקורות" FontWeight="SemiBold" Margin="0,0,0,7"/>
      <DataGrid x:Name="SourcesGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                CanUserDeleteRows="False" CanUserSortColumns="False" HeadersVisibility="Column" RowHeaderWidth="0"
                Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" GridLinesVisibility="Horizontal"
                HorizontalGridLinesBrush="{StaticResource Line}" HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto" Visibility="Collapsed" SelectionMode="Single">
        <DataGrid.GroupStyle>
          <GroupStyle>
            <GroupStyle.HeaderTemplate>
              <DataTemplate>
                <CheckBox Content="{Binding Name}" Margin="7,10" Foreground="White" FontWeight="SemiBold"
                          IsThreeState="True" IsChecked="{Binding Converter={StaticResource GroupCheck}, Mode=OneWay}" Click="OnGroupClick"
                          ToolTip="סימון או ביטול של כל המקורות בקטגוריה זו"/>
              </DataTemplate>
            </GroupStyle.HeaderTemplate>
          </GroupStyle>
        </DataGrid.GroupStyle>
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="כלול" Width="50">
            <DataGridTemplateColumn.CellTemplate><DataTemplate>
              <CheckBox IsChecked="{Binding Included, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Click="OnRowCheck"/>
            </DataTemplate></DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="מקור / נתיב מוגדר" Width="*" MinWidth="175">
            <DataGridTemplateColumn.CellTemplate><DataTemplate>
              <StackPanel Margin="5,7" ToolTip="{Binding Path}">
                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FlowDirection="LeftToRight" TextAlignment="Right"/>
                <TextBlock Text="{Binding Path}" FontSize="11" Foreground="#FF9AA4B2" TextTrimming="CharacterEllipsis"
                           FlowDirection="LeftToRight" TextAlignment="Right" Margin="0,5,0,0"/>
                <TextBlock Text="ישויות: לא ידוע — לפני מדידה" FontSize="11" Foreground="#FF9AA4B2" Margin="0,4,0,0"/>
              </StackPanel>
            </DataTemplate></DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="מצב" Width="85">
            <DataGridTemplateColumn.CellTemplate><DataTemplate>
              <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="5"/>
            </DataTemplate></DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="קטגוריה (ניתנת לשינוי)" Width="155">
            <DataGridTemplateColumn.CellTemplate><DataTemplate>
              <ComboBox ItemsSource="{Binding CategoryOptions}" DisplayMemberPath="Value" SelectedValuePath="Key"
                        SelectedValue="{Binding Category, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Foreground="Black" Background="White" VerticalAlignment="Center" Margin="4"/>
            </DataTemplate></DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
      <Expander x:Name="InventoryExpander" Grid.Row="2" Header="מצאי מלא וענפים מקוננים — פרטים" IsExpanded="True"
                Foreground="#FFE6E9EF" Margin="0,8,0,0" MaxHeight="180">
      <TextBox x:Name="InventoryText" MinHeight="80"
               IsReadOnly="True" IsReadOnlyCaretVisible="False" AcceptsReturn="True"
               TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
               HorizontalScrollBarVisibility="Disabled" Padding="12,10"
               Background="{StaticResource Panel}" Foreground="#FFE6E9EF"
               BorderBrush="{StaticResource Line}" BorderThickness="1"
               VerticalContentAlignment="Top" SpellCheck.IsEnabled="False"
               AutomationProperties.Name="רשימת מקורות האומדן המלאה"/>
      </Expander>
    </Grid>

    <TextBlock x:Name="SelectionSummary" Grid.Row="2" Margin="0,0,0,8" TextWrapping="Wrap" Foreground="#FFFFD38A"/>
    <Border Grid.Row="3" Background="{StaticResource Panel}" Padding="10"
            BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4">
      <Expander Header="תנאי ההיקף — אינו אישור לכמויות או למחירים" IsExpanded="False" Foreground="#FFE6E9EF">
        <ScrollViewer x:Name="ScopeScroll" MaxHeight="120" Margin="0,5,0,0"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      AutomationProperties.Name="היקף האישור המלא">
          <TextBlock x:Name="ScopeText" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
        </ScrollViewer>
      </Expander>
    </Border>

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,14,0,0">
      <Button x:Name="BtnApprove" Content="אשר את מקורות האומדן"
              Click="OnApprove" IsDefault="False" Style="{StaticResource PrimaryButton}"/>
      <Button x:Name="BtnCancel" Content="ביטול" Click="OnCancel" IsCancel="True" MinWidth="88"/>
    </StackPanel>
  </Grid>
</Window>
