<Window x:Class="MahodAI.Civil3D.Plugin.CivilDelivery.UI.EstimateSourceReviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MahodAI.Civil3D.Plugin.CivilDelivery.UI"
        Title="אישור מקורות האומדן" Width="940" Height="760"
        MinWidth="580" MinHeight="560" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FlowDirection="RightToLeft" Background="#FFF0F2F5" Foreground="#FF1C2420"
        FontFamily="./Fonts/#Rubik, Segoe UI, Arial" FontSize="12.5" UseLayoutRounding="True">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="CivilDeliveryTheme.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <local:SourceGroupCheckConverter x:Key="GroupCheck"/>
      <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Padding" Value="16,9"/>
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="Margin" Value="8,0,0,0"/>
      </Style>
      <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource Ink}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Ink}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
      </Style>
    </ResourceDictionary>
  </Window.Resources>

  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock Text="אישור מקורות האומדן" Style="{StaticResource DialogTitle}"/>
      <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Style="{StaticResource MutedText}"
                 Text="בחר קבצים וקטגוריות לפני המדידה. הסיווג לפי שם הוא הצעה בלבד; אפשר לשנות אותו בלי לשנות את הסימון."/>
    </StackPanel>

    <Grid Grid.Row="1" Margin="0,8,0,4">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock Text="רשימת המקורות" Style="{StaticResource MutedText}" Margin="2,0,2,6"/>
      <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6">
      <DataGrid x:Name="SourcesGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                CanUserDeleteRows="False" CanUserSortColumns="False" HeadersVisibility="Column" RowHeaderWidth="0"
                BorderThickness="0" GridLinesVisibility="Horizontal" RowHeight="NaN"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto" Visibility="Collapsed" SelectionMode="Single">
        <DataGrid.GroupStyle>
          <GroupStyle>
            <GroupStyle.HeaderTemplate>
              <DataTemplate>
                <CheckBox Content="{Binding Name}" Margin="7,10" FontWeight="SemiBold"
                          IsThreeState="True" IsChecked="{Binding Converter={StaticResource GroupCheck}, Mode=OneWay}" Click="OnGroupClick"
                          ToolTip="סימון או ביטול של כל המקורות בקטגוריה זו"/>
              </DataTemplate>
            </GroupStyle.HeaderTemplate>
          </GroupStyle>
        </DataGrid.GroupStyle>
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="כלול" Width="50">
            <DataGridTemplateColumn.CellTemplate><DataTemplate>
              <CheckBox IsChecked="{Binding Included, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Click="OnRowCheck"/>
            </DataTemplate></DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="מקור / נתיב מוגדר" Width="*" MinWidth="175">
            <DataGridTemplateColumn.CellTemplate><DataTemplate>
              <StackPanel Margin="5,7" ToolTip="{Binding Path}">
                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FlowDirection="LeftToRight" TextAlignment="Right"/>
                <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"
                           FlowDirection="LeftToRight" TextAlignment="Right" Margin="0,5,0,0"/>
                <TextBlock Text="ישויות: לא ידוע — לפני מדידה" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
              </StackPanel>
            </DataTemplate></DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="מצב" Width="85">
            <DataGridTemplateColumn.CellTemplate><DataTemplate>
              <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="5"/>
            </DataTemplate></DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="קטגוריה (ניתנת לשינוי)" Width="155">
            <DataGridTemplateColumn.CellTemplate><DataTemplate>
              <ComboBox ItemsSource="{Binding CategoryOptions}" DisplayMemberPath="Value" SelectedValuePath="Key"
                        SelectedValue="{Binding Category, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        VerticalAlignment="Center" Margin="4" MinHeight="30" Padding="10,4,8,4"/>
            </DataTemplate></DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
      </Border>
      <Expander x:Name="InventoryExpander" Grid.Row="2" Header="מצאי מלא וענפים מקוננים — פרטים" IsExpanded="True"
                Margin="0,8,0,0" MaxHeight="180">
      <TextBox x:Name="InventoryText" MinHeight="80"
               IsReadOnly="True" IsReadOnlyCaretVisible="False" AcceptsReturn="True"
               TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
               HorizontalScrollBarVisibility="Disabled" Padding="12,10"
               VerticalContentAlignment="Top" SpellCheck.IsEnabled="False"
               AutomationProperties.Name="רשימת מקורות האומדן המלאה"/>
      </Expander>
    </Grid>

    <TextBlock x:Name="SelectionSummary" Grid.Row="2" Margin="2,0,2,8" TextWrapping="Wrap" Foreground="{StaticResource Warn}"/>
    <Border Grid.Row="3" Style="{StaticResource Card}" Padding="12,5">
      <Expander Header="תנאי ההיקף — אינו אישור לכמויות או למחירים" IsExpanded="False">
        <ScrollViewer x:Name="ScopeScroll" MaxHeight="120" Margin="0,5,0,0"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      AutomationProperties.Name="היקף האישור המלא">
          <TextBlock x:Name="ScopeText" TextWrapping="Wrap" Style="{StaticResource MutedText}"/>
        </ScrollViewer>
      </Expander>
    </Border>

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
      <Button x:Name="BtnApprove" Content="אשר את מקורות האומדן"
              Click="OnApprove" IsDefault="False" Style="{StaticResource PrimaryButton}"/>
      <Button x:Name="BtnCancel" Content="ביטול" Click="OnCancel" IsCancel="True" MinWidth="88"/>
    </StackPanel>
  </Grid>
</Window>
