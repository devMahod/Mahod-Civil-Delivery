<Window x:Class="MahodAI.Civil3D.Plugin.CivilDelivery.UI.EarthworksDecisionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="החלטת היקף עבודות עפר" Width="580" SizeToContent="Height"
        MinWidth="520" MinHeight="420" WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft" ShowInTaskbar="False"
        Background="#FFF0F2F5" Foreground="#FF1C2420"
        FontFamily="./Fonts/#Rubik, Segoe UI, Arial" FontSize="12.5" UseLayoutRounding="True">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="CivilDeliveryTheme.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <!-- Two rows (b20/b21, the same defect as the exclusion dialog: at its minimum size the buttons were cut off).
       The Auto footer row is measured before the star row, so the approver, the validation text and the buttons
       keep their room while the choice above scrolls. The content is declared first, so Tab still goes choice ->
       reason -> approver -> buttons; the ScrollViewer is not a tab stop. SizeToContent opens the window with
       everything visible. -->
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Focusable="False" IsTabStop="False">
      <StackPanel>
        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
          <StackPanel>
            <TextBlock Text="מצב נוכחי" Style="{StaticResource CardTitle}"/>
            <TextBlock x:Name="CurrentStateText" Style="{StaticResource SoftText}"
                       Margin="0,4,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>

        <TextBlock Text="החלטה" Style="{StaticResource MutedText}" Margin="2,0,2,6"/>
        <RadioButton x:Name="IncludeRadio" GroupName="EarthworksScope"
                     Checked="OnInputChanged" Margin="2,4,2,4">
          <StackPanel>
            <TextBlock Text="לכלול עבודות עפר באומדן" FontWeight="SemiBold"/>
            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                       Text="הכמויות יחושבו רק מכיסוי חתכים ומקורות קרקע/תכנון מוכחים; חוסר או עמימות יחסמו ייצוא."/>
          </StackPanel>
        </RadioButton>
        <RadioButton x:Name="ExcludeRadio" GroupName="EarthworksScope"
                     Checked="OnInputChanged" Margin="2,7,2,10">
          <StackPanel>
            <TextBlock Text="עבודות עפר מחוץ להיקף האומדן" FontWeight="SemiBold"/>
            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                       Text="הכמות לא תוצג כאפס. ההחרגה תישמר כהחלטה הנדסית ניתנת לביקורת."/>
          </StackPanel>
        </RadioButton>

        <TextBlock Text="סיבה הנדסית להחרגה (חובה)" Style="{StaticResource MutedText}" Margin="2,0,2,4"/>
        <TextBox x:Name="ReasonBox" MinHeight="74" AcceptsReturn="True" VerticalContentAlignment="Top"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 TextChanged="OnInputChanged"/>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="1" Margin="0,12,0,0">
      <DockPanel Margin="0,0,0,7">
        <TextBlock Text="מאשר" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
        <TextBox x:Name="ApproverBox" Margin="8,0,0,0" MinWidth="210"
                 TextChanged="OnInputChanged"/>
      </DockPanel>
      <TextBlock Style="{StaticResource MutedText}" Margin="2,0,2,8" TextWrapping="Wrap"
                 Text="בעת השמירה יירשמו בפרופיל שם המאשר, זמן UTC, גרסה וגיבוי; כל סריקה ואומדן קודמים יבוטלו."/>
      <DockPanel LastChildFill="False">
        <TextBlock x:Name="ValidationText" DockPanel.Dock="Left"
                   Foreground="{StaticResource Warn}" VerticalAlignment="Center" TextWrapping="Wrap"/>
        <Button DockPanel.Dock="Right" Content="ביטול" Click="OnCancel" IsCancel="True" Margin="6,0,0,0"/>
        <Button x:Name="BtnSave" DockPanel.Dock="Right" Content="שמור החלטה" Margin="6,0,0,0"
                Click="OnSave" IsDefault="True" Style="{StaticResource PrimaryButton}"/>
      </DockPanel>
    </StackPanel>
  </Grid>
</Window>
