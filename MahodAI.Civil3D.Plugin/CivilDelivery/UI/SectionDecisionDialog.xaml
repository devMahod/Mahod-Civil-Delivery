<Window x:Class="MahodAI.Civil3D.Plugin.CivilDelivery.UI.SectionDecisionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="הכרעת רשומת חתך" Width="650" Height="520"
        MinWidth="560" MinHeight="440" WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft" ShowInTaskbar="False"
        Background="#FFF0F2F5" Foreground="#FF1C2420"
        FontFamily="./Fonts/#Rubik, Segoe UI, Arial" FontSize="12.5" UseLayoutRounding="True">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="CivilDeliveryTheme.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <DockPanel Margin="16">
    <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,9">
      <StackPanel>
        <TextBlock x:Name="SubjectTitle" Style="{StaticResource CardTitle}"/>
        <TextBlock x:Name="SubjectDetail" Style="{StaticResource SoftText}"
                   Margin="0,4,0,0" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>

    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <DockPanel Margin="0,0,0,8">
        <TextBlock Text="מאשר" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
        <TextBox x:Name="ApproverBox" Margin="8,0,0,0" MinWidth="190"
                 TextChanged="OnInputChanged"/>
      </DockPanel>
      <DockPanel LastChildFill="False">
        <TextBlock x:Name="ValidationText" DockPanel.Dock="Left"
                   Foreground="{StaticResource Warn}" VerticalAlignment="Center" TextWrapping="Wrap"/>
        <Button DockPanel.Dock="Right" Content="ביטול" Click="OnCancel" IsCancel="True" Margin="6,0,0,0"/>
        <Button x:Name="BtnSave" DockPanel.Dock="Right" Content="שמור הכרעה" Margin="6,0,0,0"
                Click="OnSave" IsDefault="True" Style="{StaticResource PrimaryButton}"/>
      </DockPanel>
    </StackPanel>

    <TabControl x:Name="ModeTabs" SelectionChanged="OnModeChanged">
      <TabItem x:Name="ResolveTab" Header="בחירת חצייה מדויקת">
        <Border Style="{StaticResource Card}" Padding="10">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Style="{StaticResource MutedText}"
                     Margin="2,0,2,8" TextWrapping="Wrap"
                     Text="בחר תוואי ותחנה מתוך החציות שנמדדו בפועל. הבחירה נשמרת לפי hash+handle ותיפסל אם הגאומטריה תשתנה."/>
          <DataGrid x:Name="CandidatesGrid" SelectionChanged="OnCandidateChanged" BorderThickness="0">
            <DataGrid.Columns>
              <DataGridTextColumn Header="תוואי" Binding="{Binding Alignment}" Width="*"/>
              <DataGridTextColumn Header="תחנה" Binding="{Binding Station}" Width="100"/>
              <DataGridTextColumn Header="X / Y" Binding="{Binding Point}" Width="170"/>
              <DataGridTextColumn Header="פער" Binding="{Binding Gap}" Width="75"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
        </Border>
      </TabItem>
      <TabItem Header="החרגה מפורשת">
        <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="קוד הממצא שעל בסיסו מאושרת ההחרגה" Style="{StaticResource MutedText}" Margin="2,0,2,4"/>
          <ComboBox x:Name="FindingCodeBox" DisplayMemberPath="Label"
                    SelectionChanged="OnFindingChanged"/>
          <CheckBox x:Name="BatchCheck" Margin="2,10,2,8" Checked="OnInputChanged"
                    Unchecked="OnInputChanged"
                    Content="להחיל על כל הרשומות הלא-פתורות עם אותו קוד ממצא"/>
          <TextBlock x:Name="BatchHint" Style="{StaticResource MutedText}" Margin="2,0,2,10" TextWrapping="Wrap"/>
          <TextBlock Text="סיבת החרגה הנדסית (חובה)" Style="{StaticResource MutedText}" Margin="2,0,2,4"/>
          <TextBox x:Name="ReasonBox" MinHeight="92" AcceptsReturn="True" VerticalContentAlignment="Top"
                   TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                   TextChanged="OnInputChanged"/>
          <TextBlock Foreground="{StaticResource Warn}" Margin="2,10,2,0" TextWrapping="Wrap"
                     Text="החרגה אינה מוחקת דבר. היא נשמרת בפרופיל ומופיעה ב-PLAN/VERIFY עם מאשר, סיבה וזמן."/>
        </StackPanel>
        </Border>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
