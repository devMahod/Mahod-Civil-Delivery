<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:prim="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">

  <!-- ======================================================================
       Mahod Civil Delivery theme (2026-10): the Mahod house look (TenderOS
       "clean" skin) for every palette and dialog of this tool. Light grey
       canvas, white rounded cards, one ink colour, Rubik, outline icons in
       one colour, green only where it carries meaning (the current step, a
       good status). Every window merges this dictionary; code-built windows
       go through CivilDeliveryTheme.Apply.
       Keys are plain XAML (no plugin types) so the offline layout tests can
       XamlReader.Parse the windows that merge it.
       ====================================================================== -->

  <!-- Rubik ships inside the plugin (the Fonts folder, OFL licence); "./" is this dictionary's own folder, in the assembly or on disk. -->
  <FontFamily x:Key="Font">./Fonts/#Rubik, Segoe UI, Arial</FontFamily>

  <!-- tokens -->
  <SolidColorBrush x:Key="Canvas"      Color="#FFF0F2F5"/>
  <SolidColorBrush x:Key="Panel"       Color="#FFFFFFFF"/>
  <SolidColorBrush x:Key="Panel2"      Color="#FFF6F7F9"/>
  <SolidColorBrush x:Key="Ink"         Color="#FF1C2420"/>
  <SolidColorBrush x:Key="Text"        Color="#FF1C2420"/>
  <SolidColorBrush x:Key="TextSoft"    Color="#FF55605B"/>
  <SolidColorBrush x:Key="Muted"       Color="#FF6B7570"/>
  <SolidColorBrush x:Key="TextDim"     Color="#FF6B7570"/>
  <SolidColorBrush x:Key="IconInk"     Color="#FF5D6863"/>
  <SolidColorBrush x:Key="IconBg"      Color="#FFF3F5F7"/>
  <SolidColorBrush x:Key="Rule"        Color="#FFEDF0F2"/>
  <SolidColorBrush x:Key="Frame"       Color="#FFE1E5EA"/>
  <SolidColorBrush x:Key="Line"        Color="#FFE1E5EA"/>
  <SolidColorBrush x:Key="FrameStrong" Color="#FFC3CAD2"/>
  <SolidColorBrush x:Key="Focus"       Color="#FF659287"/>
  <SolidColorBrush x:Key="Hover"       Color="#FFF3F7F4"/>
  <!-- the one accent: where you are / what is good -->
  <SolidColorBrush x:Key="Accent"      Color="#FF1C9A5B"/>
  <SolidColorBrush x:Key="AccentTint"  Color="#FFE5F6EC"/>
  <SolidColorBrush x:Key="AccentInk"   Color="#FF0F5D3A"/>
  <SolidColorBrush x:Key="Selection"   Color="#FFE5F6EC"/>
  <!-- status: ok / review / blocked -->
  <SolidColorBrush x:Key="Ok"          Color="#FF1C9A5B"/>
  <SolidColorBrush x:Key="OkTint"      Color="#FFE5F6EC"/>
  <SolidColorBrush x:Key="Review"      Color="#FFB8700F"/>
  <SolidColorBrush x:Key="ReviewTint"  Color="#FFFBF1E1"/>
  <SolidColorBrush x:Key="Warn"        Color="#FFB8700F"/>
  <SolidColorBrush x:Key="Blocked"     Color="#FFC2413B"/>
  <SolidColorBrush x:Key="BlockedTint" Color="#FFFBE9E8"/>
  <!-- the group panel (one per screen): green gradient, green ink -->
  <SolidColorBrush x:Key="GroupInk"      Color="#FF103325"/>
  <SolidColorBrush x:Key="GroupMuted"    Color="#FF2F5A48"/>
  <SolidColorBrush x:Key="GroupLine"     Color="#29103325"/>
  <SolidColorBrush x:Key="GroupTileFill" Color="#57FFFFFF"/>
  <SolidColorBrush x:Key="GroupTileLine" Color="#BFFFFFFF"/>
  <SolidColorBrush x:Key="GroupTileHover" Color="#99FFFFFF"/>
  <LinearGradientBrush x:Key="GroupGradient" StartPoint="0.25,0" EndPoint="0.75,1">
    <GradientStop Color="#FFC9F1DC" Offset="0"/>
    <GradientStop Color="#FF8FDCB6" Offset="1"/>
  </LinearGradientBrush>
  <!-- the two faint shapes in the far corner of the group panel, drawn in the
       panel's own background so its rounded corner clips them -->
  <DrawingBrush x:Key="GroupShapes" Stretch="None" AlignmentX="Left" AlignmentY="Top" TileMode="None"
                ViewboxUnits="Absolute" Viewbox="0,0,260,170" ViewportUnits="Absolute" Viewport="0,0,260,170">
    <DrawingBrush.Drawing>
      <DrawingGroup>
        <GeometryDrawing>
          <GeometryDrawing.Pen><Pen Thickness="1" Brush="#59FFFFFF"/></GeometryDrawing.Pen>
          <GeometryDrawing.Brush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0.6,1">
              <GradientStop Color="#8CFFFFFF" Offset="0"/><GradientStop Color="#0DFFFFFF" Offset="1"/>
            </LinearGradientBrush>
          </GeometryDrawing.Brush>
          <GeometryDrawing.Geometry>
            <RectangleGeometry Rect="-46,-84,170,170" RadiusX="28" RadiusY="28">
              <RectangleGeometry.Transform><RotateTransform Angle="28" CenterX="39" CenterY="1"/></RectangleGeometry.Transform>
            </RectangleGeometry>
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing>
          <GeometryDrawing.Pen><Pen Thickness="1" Brush="#40FFFFFF"/></GeometryDrawing.Pen>
          <GeometryDrawing.Brush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0.6,1">
              <GradientStop Color="#62FFFFFF" Offset="0"/><GradientStop Color="#09FFFFFF" Offset="1"/>
            </LinearGradientBrush>
          </GeometryDrawing.Brush>
          <GeometryDrawing.Geometry>
            <RectangleGeometry Rect="66,-36,100,100" RadiusX="28" RadiusY="28">
              <RectangleGeometry.Transform><RotateTransform Angle="14" CenterX="116" CenterY="14"/></RectangleGeometry.Transform>
            </RectangleGeometry>
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingBrush.Drawing>
  </DrawingBrush>

