  <!-- text -->
  <Style x:Key="MutedText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Muted}"/>
    <Setter Property="FontSize" Value="11.5"/>
  </Style>
  <Style x:Key="SoftText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextSoft}"/>
    <Setter Property="FontSize" Value="12"/>
  </Style>
  <!-- a window's own short title, inside the window -->
  <Style x:Key="CardTitle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    <Setter Property="FontSize" Value="13.5"/>
    <Setter Property="FontWeight" Value="Medium"/>
  </Style>
  <Style x:Key="DialogTitle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    <Setter Property="FontSize" Value="17"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <!-- table cells: trim with an ellipsis, full text on hover -->
  <Style x:Key="Cell" TargetType="TextBlock">
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
    <Setter Property="Margin" Value="4,0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="CellText" TargetType="TextBlock">
    <Setter Property="Margin" Value="6,4"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="LtrCellText" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
    <Setter Property="FlowDirection" Value="LeftToRight"/>
  </Style>
  <Style x:Key="WrappedCellText" TargetType="TextBlock">
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="Margin" Value="6,4"/>
  </Style>
  <Style x:Key="NumericCellText" TargetType="TextBlock">
    <Setter Property="FlowDirection" Value="LeftToRight"/>
    <Setter Property="Margin" Value="6,4"/>
  </Style>
  <Style TargetType="Hyperlink">
    <Setter Property="Foreground" Value="{StaticResource AccentInk}"/>
    <Setter Property="TextDecorations" Value="{x:Null}"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="TextDecorations" Value="Underline"/>
        <Setter Property="Foreground" Value="{StaticResource Accent}"/>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="Label">
    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    <Setter Property="Padding" Value="0"/>
  </Style>

  <!-- cards -->
  <!-- a white window on the grey canvas -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Panel}"/>
    <Setter Property="CornerRadius" Value="14"/>
    <Setter Property="Padding" Value="14,12"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>
  <!-- a quieter grey window inside a white one -->
  <Style x:Key="InsetCard" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Panel2}"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="Padding" Value="12,10"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <!-- the one green window on a screen: the step the engineer is in -->
  <Style x:Key="GroupPanel" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource GroupGradient}"/>
    <Setter Property="CornerRadius" Value="18"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="TextElement.Foreground" Value="{StaticResource GroupInk}"/>
  </Style>
  <!-- the decorative corner of the group panel; sits under the content -->
  <Style x:Key="GroupPanelShapes" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource GroupShapes}"/>
    <Setter Property="CornerRadius" Value="18"/>
    <Setter Property="FlowDirection" Value="LeftToRight"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
  </Style>
  <Style x:Key="GroupTitle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource GroupInk}"/>
    <Setter Property="FontSize" Value="15.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="GroupText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource GroupMuted}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <!-- a small tile inside the group panel (a step); Tag="current" lights it -->
  <Style x:Key="GroupTile" TargetType="Border">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="11"/>
    <Setter Property="Padding" Value="8,6"/>
    <Setter Property="Margin" Value="0,0,6,0"/>
    <Setter Property="TextElement.Foreground" Value="{StaticResource GroupMuted}"/>
    <Style.Triggers>
      <Trigger Property="Tag" Value="done">
        <Setter Property="Background" Value="{StaticResource GroupTileFill}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GroupTileLine}"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource GroupInk}"/>
      </Trigger>
      <Trigger Property="Tag" Value="current">
        <Setter Property="Background" Value="{StaticResource Panel}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Panel}"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource AccentInk}"/>
        <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- buttons -->
  <!-- The content is one wrapping TextBlock (the layout tests count on it);
       an outline icon appears before it when the button carries a Tag. -->
  <ControlTemplate x:Key="ButtonTemplate" TargetType="Button">
    <Border x:Name="b" Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="10" SnapsToDevicePixels="True">
      <DockPanel Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Path x:Name="icon" DockPanel.Dock="Left" Visibility="Collapsed" Width="15" Height="15" Margin="0,0,7,0"
              Stretch="Uniform" StrokeThickness="1.7" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              FlowDirection="LeftToRight" VerticalAlignment="Center"
              Stroke="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="b" Property="Background" Value="{StaticResource Hover}"/>
        <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource FrameStrong}"/>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="b" Property="Background" Value="{StaticResource Rule}"/>
      </Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Focus}"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="b" Property="Background" Value="{StaticResource Panel2}"/>
        <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Rule}"/>
        <Setter Property="Foreground" Value="#FF8E9792"/>
        <Setter Property="Cursor" Value="Arrow"/>
      </Trigger>
      <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="search"><Setter TargetName="icon" Property="Data" Value="{StaticResource IconSearch}"/><Setter TargetName="icon" Property="Visibility" Value="Visible"/></DataTrigger>
      <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="play"><Setter TargetName="icon" Property="Data" Value="{StaticResource IconPlay}"/><Setter TargetName="icon" Property="Visibility" Value="Visible"/></DataTrigger>
      <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="locate"><Setter TargetName="icon" Property="Data" Value="{StaticResource IconCrosshair}"/><Setter TargetName="icon" Property="Visibility" Value="Visible"/></DataTrigger>
      <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="scan"><Setter TargetName="icon" Property="Data" Value="{StaticResource IconScan}"/><Setter TargetName="icon" Property="Visibility" Value="Visible"/></DataTrigger>
      <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="download"><Setter TargetName="icon" Property="Data" Value="{StaticResource IconDownload}"/><Setter TargetName="icon" Property="Visibility" Value="Visible"/></DataTrigger>
      <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="upload"><Setter TargetName="icon" Property="Data" Value="{StaticResource IconUpload}"/><Setter TargetName="icon" Property="Visibility" Value="Visible"/></DataTrigger>
      <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="sheet"><Setter TargetName="icon" Property="Data" Value="{StaticResource IconSheet}"/><Setter TargetName="icon" Property="Visibility" Value="Visible"/></DataTrigger>
      <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="file"><Setter TargetName="icon" Property="Data" Value="{StaticResource IconFileText}"/><Setter TargetName="icon" Property="Visibility" Value="Visible"/></DataTrigger>
      <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="folder"><Setter TargetName="icon" Property="Data" Value="{StaticResource IconFolder}"/><Setter TargetName="icon" Property="Visibility" Value="Visible"/></DataTrigger>
      <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="refresh"><Setter TargetName="icon" Property="Data" Value="{StaticResource IconRefresh}"/><Setter TargetName="icon" Property="Visibility" Value="Visible"/></DataTrigger>
      <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="book"><Setter TargetName="icon" Property="Data" Value="{StaticResource IconBook}"/><Setter TargetName="icon" Property="Visibility" Value="Visible"/></DataTrigger>
      <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="support"><Setter TargetName="icon" Property="Data" Value="{StaticResource IconLifeBuoy}"/><Setter TargetName="icon" Property="Visibility" Value="Visible"/></DataTrigger>
      <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="sliders"><Setter TargetName="icon" Property="Data" Value="{StaticResource IconSliders}"/><Setter TargetName="icon" Property="Visibility" Value="Visible"/></DataTrigger>
      <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="layers"><Setter TargetName="icon" Property="Data" Value="{StaticResource IconLayers}"/><Setter TargetName="icon" Property="Visibility" Value="Visible"/></DataTrigger>
      <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="pin"><Setter TargetName="icon" Property="Data" Value="{StaticResource IconMapPin}"/><Setter TargetName="icon" Property="Visibility" Value="Visible"/></DataTrigger>
      <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="x"><Setter TargetName="icon" Property="Data" Value="{StaticResource IconX}"/><Setter TargetName="icon" Property="Visibility" Value="Visible"/></DataTrigger>
      <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="check"><Setter TargetName="icon" Property="Data" Value="{StaticResource IconCheck}"/><Setter TargetName="icon" Property="Visibility" Value="Visible"/></DataTrigger>
      <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="route"><Setter TargetName="icon" Property="Data" Value="{StaticResource IconRoute}"/><Setter TargetName="icon" Property="Visibility" Value="Visible"/></DataTrigger>
      <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="calc"><Setter TargetName="icon" Property="Data" Value="{StaticResource IconCalculator}"/><Setter TargetName="icon" Property="Visibility" Value="Visible"/></DataTrigger>
      <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="price"><Setter TargetName="icon" Property="Data" Value="{StaticResource IconBanknote}"/><Setter TargetName="icon" Property="Visibility" Value="Visible"/></DataTrigger>
      <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="maximize"><Setter TargetName="icon" Property="Data" Value="{StaticResource IconMaximize}"/><Setter TargetName="icon" Property="Visibility" Value="Visible"/></DataTrigger>
      <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="filter"><Setter TargetName="icon" Property="Data" Value="{StaticResource IconFilter}"/><Setter TargetName="icon" Property="Visibility" Value="Visible"/></DataTrigger>
      <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="user"><Setter TargetName="icon" Property="Data" Value="{StaticResource IconUser}"/><Setter TargetName="icon" Property="Visibility" Value="Visible"/></DataTrigger>
      <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="link"><Setter TargetName="icon" Property="Data" Value="{StaticResource IconLink}"/><Setter TargetName="icon" Property="Visibility" Value="Visible"/></DataTrigger>
      <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="pen"><Setter TargetName="icon" Property="Data" Value="{StaticResource IconPen}"/><Setter TargetName="icon" Property="Visibility" Value="Visible"/></DataTrigger>
      <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="hide"><Setter TargetName="icon" Property="Data" Value="{StaticResource IconEyeOff}"/><Setter TargetName="icon" Property="Visibility" Value="Visible"/></DataTrigger>
      <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="grid"><Setter TargetName="icon" Property="Data" Value="{StaticResource IconGrid}"/><Setter TargetName="icon" Property="Visibility" Value="Visible"/></DataTrigger>
      <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="ruler"><Setter TargetName="icon" Property="Data" Value="{StaticResource IconRuler}"/><Setter TargetName="icon" Property="Visibility" Value="Visible"/></DataTrigger>
      <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="chevron"><Setter TargetName="icon" Property="Data" Value="{StaticResource IconChevronLeft}"/><Setter TargetName="icon" Property="Visibility" Value="Visible"/></DataTrigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <DataTemplate x:Key="ButtonLabel">
    <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center"
               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
               FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=Button}}"/>
  </DataTemplate>

  <Style TargetType="Button">
    <Setter Property="Background" Value="{StaticResource Panel}"/>
    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Frame}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="10,7"/>
    <Setter Property="Margin" Value="0,0,5,5"/>
    <Setter Property="MinWidth" Value="72"/>
    <Setter Property="MinHeight" Value="34"/>
    <Setter Property="MaxWidth" Value="260"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
    <Setter Property="ContentTemplate" Value="{StaticResource ButtonLabel}"/>
    <Setter Property="Template" Value="{StaticResource ButtonTemplate}"/>
  </Style>
  <!-- the one action that moves the work forward: ink, white text -->
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{StaticResource Ink}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Ink}"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" SnapsToDevicePixels="True">
            <DockPanel Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Path x:Name="icon" DockPanel.Dock="Left" Visibility="Collapsed" Width="15" Height="15" Margin="0,0,7,0"
                    Stretch="Uniform" StrokeThickness="1.7" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    FlowDirection="LeftToRight" VerticalAlignment="Center"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </DockPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#FF2E3A34"/><Setter TargetName="b" Property="BorderBrush" Value="#FF2E3A34"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="#FF0F1512"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Focus}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="b" Property="Background" Value="#FF9AA39E"/>
              <Setter TargetName="b" Property="BorderBrush" Value="#FF9AA39E"/>
              <Setter Property="Foreground" Value="White"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="play"><Setter TargetName="icon" Property="Data" Value="{StaticResource IconPlay}"/><Setter TargetName="icon" Property="Visibility" Value="Visible"/></DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="scan"><Setter TargetName="icon" Property="Data" Value="{StaticResource IconScan}"/><Setter TargetName="icon" Property="Visibility" Value="Visible"/></DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="download"><Setter TargetName="icon" Property="Data" Value="{StaticResource IconDownload}"/><Setter TargetName="icon" Property="Visibility" Value="Visible"/></DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="sheet"><Setter TargetName="icon" Property="Data" Value="{StaticResource IconSheet}"/><Setter TargetName="icon" Property="Visibility" Value="Visible"/></DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="check"><Setter TargetName="icon" Property="Data" Value="{StaticResource IconCheck}"/><Setter TargetName="icon" Property="Visibility" Value="Visible"/></DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="calc"><Setter TargetName="icon" Property="Data" Value="{StaticResource IconCalculator}"/><Setter TargetName="icon" Property="Visibility" Value="Visible"/></DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- pills inside the green group panel -->
  <Style x:Key="PillButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{StaticResource GroupTileFill}"/>
    <Setter Property="BorderBrush" Value="{StaticResource GroupTileLine}"/>
    <Setter Property="Foreground" Value="{StaticResource GroupInk}"/>
    <Setter Property="Padding" Value="13,6"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1" CornerRadius="17" SnapsToDevicePixels="True">
            <DockPanel Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Path x:Name="icon" DockPanel.Dock="Left" Visibility="Collapsed" Width="15" Height="15" Margin="0,0,7,0"
                    Stretch="Uniform" StrokeThickness="1.7" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    FlowDirection="LeftToRight" VerticalAlignment="Center"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </DockPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="b" Property="Background" Value="{StaticResource Panel}"/>
              <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Panel}"/>
              <Setter Property="Foreground" Value="{StaticResource AccentInk}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Panel}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="b" Property="Background" Value="#2EFFFFFF"/>
              <Setter TargetName="b" Property="BorderBrush" Value="#66FFFFFF"/>
              <Setter Property="Foreground" Value="#FF5E7B6C"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="locate"><Setter TargetName="icon" Property="Data" Value="{StaticResource IconCrosshair}"/><Setter TargetName="icon" Property="Visibility" Value="Visible"/></DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="layers"><Setter TargetName="icon" Property="Data" Value="{StaticResource IconLayers}"/><Setter TargetName="icon" Property="Visibility" Value="Visible"/></DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="sheet"><Setter TargetName="icon" Property="Data" Value="{StaticResource IconSheet}"/><Setter TargetName="icon" Property="Visibility" Value="Visible"/></DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="ruler"><Setter TargetName="icon" Property="Data" Value="{StaticResource IconRuler}"/><Setter TargetName="icon" Property="Visibility" Value="Visible"/></DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="PillPrimaryButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
    <Setter Property="Background" Value="{StaticResource Panel}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Panel}"/>
    <Setter Property="Foreground" Value="{StaticResource AccentInk}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1" CornerRadius="17" SnapsToDevicePixels="True">
            <DockPanel Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Path x:Name="icon" DockPanel.Dock="Left" Visibility="Collapsed" Width="15" Height="15" Margin="0,0,7,0"
                    Stretch="Uniform" StrokeThickness="1.9" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    FlowDirection="LeftToRight" VerticalAlignment="Center"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </DockPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#FFF2FBF6"/><Setter TargetName="b" Property="BorderBrush" Value="#FFF2FBF6"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="#FFE5F6EC"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource AccentInk}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="b" Property="Background" Value="#A6FFFFFF"/>
              <Setter TargetName="b" Property="BorderBrush" Value="#A6FFFFFF"/>
              <Setter Property="Foreground" Value="#FF4F7A64"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="play"><Setter TargetName="icon" Property="Data" Value="{StaticResource IconPlay}"/><Setter TargetName="icon" Property="Visibility" Value="Visible"/></DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="scan"><Setter TargetName="icon" Property="Data" Value="{StaticResource IconScan}"/><Setter TargetName="icon" Property="Visibility" Value="Visible"/></DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="chevron"><Setter TargetName="icon" Property="Data" Value="{StaticResource IconChevronLeft}"/><Setter TargetName="icon" Property="Visibility" Value="Visible"/></DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- a small quiet button (clear, close) -->
  <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Foreground" Value="{StaticResource Muted}"/>
    <Setter Property="MinWidth" Value="34"/>
    <Setter Property="Padding" Value="8,6"/>
  </Style>

  <!-- toggle: pressed = the mint pill of "where you are" -->
  <Style TargetType="ToggleButton">
    <Setter Property="Background" Value="{StaticResource Panel}"/>
    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Frame}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="12,7"/>
    <Setter Property="MinHeight" Value="34"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Hover}"/></Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="b" Property="Background" Value="{StaticResource AccentTint}"/>
              <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource AccentTint}"/>
              <Setter Property="Foreground" Value="{StaticResource Accent}"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Focus}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- tabs -->
  <!-- a white pill row; the current tab is the mint pill -->
  <Style TargetType="TabControl">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabControl">
          <Grid KeyboardNavigation.TabNavigation="Local">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{StaticResource Panel}" CornerRadius="14" Padding="3" Margin="0,0,0,6">
              <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1"/>
            </Border>
            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" Margin="{TemplateBinding Padding}"
                              KeyboardNavigation.TabNavigation="Local" KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.TabIndex="2"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="TabItem">
    <Setter Property="Foreground" Value="{StaticResource TextSoft}"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Border x:Name="b" Background="Transparent" CornerRadius="10" Padding="12,6" Margin="0,0,2,0">
            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="b" Property="Background" Value="{StaticResource Hover}"/>
              <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="b" Property="Background" Value="{StaticResource AccentTint}"/>
              <Setter Property="Foreground" Value="{StaticResource Accent}"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- inputs -->
  <Style TargetType="TextBox">
    <Setter Property="Background" Value="{StaticResource Panel}"/>
    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Frame}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CaretBrush" Value="{StaticResource Ink}"/>
    <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
    <Setter Property="Padding" Value="10,6"/>
    <Setter Property="MinHeight" Value="34"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" SnapsToDevicePixels="True">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                          Focusable="False" HorizontalScrollBarVisibility="Hidden"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#8C659287"/></Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Focus}"/></Trigger>
            <Trigger Property="IsReadOnly" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Panel2}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Background" Value="{StaticResource Panel2}"/><Setter Property="Foreground" Value="{StaticResource Muted}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- the search box: the same box with the search icon inside and a hint while empty -->
  <Style x:Key="SearchBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" SnapsToDevicePixels="True">
            <DockPanel Margin="{TemplateBinding Padding}">
              <Path DockPanel.Dock="Left" Data="{StaticResource IconSearch}" Width="14" Height="14" Margin="0,0,8,0" Stretch="Uniform"
                    Stroke="{StaticResource Muted}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    FlowDirection="LeftToRight" VerticalAlignment="Center"/>
              <Grid>
                <TextBlock x:Name="hint" Text="{TemplateBinding Tag}" Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                           Visibility="Collapsed" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"/>
                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False" HorizontalScrollBarVisibility="Hidden"/>
              </Grid>
            </DockPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value=""><Setter TargetName="hint" Property="Visibility" Value="Visible"/></Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#8C659287"/></Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Focus}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- combo: one rounded box; an optional label inside it (Tag) before the value, chevron at the far end -->
  <ControlTemplate x:Key="ComboToggle" TargetType="ToggleButton">
    <Border Background="Transparent"/>
  </ControlTemplate>
  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    <Setter Property="Padding" Value="10,6"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="b" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="4,1">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Hover}"/></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource AccentTint}"/><Setter Property="Foreground" Value="{StaticResource AccentInk}"/><Setter Property="FontWeight" Value="Medium"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="Background" Value="{StaticResource Panel}"/>
    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Frame}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="12,6,8,6"/>
    <Setter Property="MinHeight" Value="34"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" SnapsToDevicePixels="True">
              <Grid Margin="{TemplateBinding Padding}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="label" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="{TemplateBinding Tag}" Foreground="{StaticResource Muted}" FontSize="11.5" FontWeight="Normal" VerticalAlignment="Center"/>
                  <Rectangle Width="1" Height="14" Fill="{StaticResource Frame}" Margin="9,0,9,0" VerticalAlignment="Center"/>
                </StackPanel>
                <ContentPresenter Grid.Column="1" x:Name="value" Content="{TemplateBinding SelectionBoxItem}"
                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                  VerticalAlignment="Center" IsHitTestVisible="False" TextBlock.Foreground="{TemplateBinding Foreground}"/>
                <TextBox Grid.Column="1" x:Name="PART_EditableTextBox" Visibility="Collapsed" Background="Transparent" BorderThickness="0"
                         Padding="0" MinHeight="0" VerticalAlignment="Center" IsReadOnly="{TemplateBinding IsReadOnly}"
                         Foreground="{TemplateBinding Foreground}" Focusable="True"/>
                <Path Grid.Column="2" Data="{StaticResource IconChevronDown}" Width="12" Height="12" Margin="8,0,0,0" Stretch="Uniform"
                      Stroke="{StaticResource Muted}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      FlowDirection="LeftToRight" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ToggleButton x:Name="toggle" Template="{StaticResource ComboToggle}" Focusable="False" ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"
                   Focusable="False" PopupAnimation="Fade" StaysOpen="False" VerticalOffset="4">
              <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Frame}" BorderThickness="1" CornerRadius="12"
                      MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Padding="0,5" SnapsToDevicePixels="True"
                      FlowDirection="{Binding FlowDirection, RelativeSource={RelativeSource TemplatedParent}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Tag" Value="{x:Null}"><Setter TargetName="label" Property="Visibility" Value="Collapsed"/></Trigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value=""><Setter TargetName="label" Property="Visibility" Value="Collapsed"/></DataTrigger>
            <Trigger Property="IsEditable" Value="True">
              <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
              <Setter TargetName="value" Property="Visibility" Value="Hidden"/>
              <Setter TargetName="toggle" Property="Grid.Column" Value="2"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#8C659287"/></Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Focus}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Background" Value="{StaticResource Panel2}"/><Setter Property="Foreground" Value="{StaticResource Muted}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style TargetType="RadioButton">
    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style TargetType="ProgressBar">
    <Setter Property="Foreground" Value="{StaticResource Accent}"/>
    <Setter Property="Background" Value="{StaticResource Rule}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Height" Value="6"/>
  </Style>
  <Style TargetType="GroupBox">
    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Frame}"/>
    <Setter Property="Padding" Value="8"/>
  </Style>
  <Style TargetType="GridSplitter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>

  <!-- expander -->
  <Style TargetType="Expander">
    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Expander">
          <StackPanel>
            <ToggleButton x:Name="head" IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                          Focusable="True" Cursor="Hand" HorizontalAlignment="Left">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="hb" Background="Transparent" CornerRadius="8" Padding="3,2">
                    <DockPanel>
                      <Path x:Name="chev" DockPanel.Dock="Left" Data="{StaticResource IconChevronDown}" Width="11" Height="11" Margin="0,0,7,0"
                            Stretch="Uniform" Stroke="{StaticResource Muted}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                            StrokeLineJoin="Round" FlowDirection="LeftToRight" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform><RotateTransform Angle="0"/></Path.RenderTransform>
                      </Path>
                      <ContentPresenter VerticalAlignment="Center" TextBlock.Foreground="{StaticResource TextSoft}" TextBlock.FontWeight="Medium"/>
                    </DockPanel>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="hb" Property="Background" Value="{StaticResource Hover}"/></Trigger>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="chev" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180"/></Setter.Value></Setter>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
              <ContentPresenter ContentSource="Header" TextBlock.Foreground="{TemplateBinding Foreground}"/>
            </ToggleButton>
            <ContentPresenter x:Name="content" Visibility="Collapsed" Margin="4,2,4,0"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="True"><Setter TargetName="content" Property="Visibility" Value="Visible"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- scrollbars -->
  <Style x:Key="ScrollThumb" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="t" Background="{StaticResource FrameStrong}" CornerRadius="4" Margin="2"/>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="t" Property="Background" Value="#FF9AA39E"/></Trigger>
            <Trigger Property="IsDragging" Value="True"><Setter TargetName="t" Property="Background" Value="{StaticResource Muted}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Width" Value="10"/>
    <Setter Property="MinWidth" Value="10"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.LineUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.LineDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
              <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}"/></Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Height" Value="10"/>
        <Setter Property="MinHeight" Value="10"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Grid Background="Transparent">
                <Track x:Name="PART_Track" IsDirectionReversed="False">
                  <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.LineLeftCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
                  <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.LineRightCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
                  <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}"/></Track.Thumb>
                </Track>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- tables -->
  <Style TargetType="DataGrid">
    <Setter Property="Background" Value="{StaticResource Panel}"/>
    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Rule}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="RowBackground" Value="{StaticResource Panel}"/>
    <Setter Property="AlternatingRowBackground" Value="{StaticResource Panel}"/>
    <Setter Property="GridLinesVisibility" Value="Horizontal"/>
    <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Rule}"/>
    <Setter Property="VerticalGridLinesBrush" Value="{StaticResource Rule}"/>
    <Setter Property="HeadersVisibility" Value="Column"/>
    <Setter Property="AutoGenerateColumns" Value="False"/>
    <Setter Property="IsReadOnly" Value="True"/>
    <Setter Property="CanUserAddRows" Value="False"/>
    <Setter Property="SelectionMode" Value="Single"/>
    <Setter Property="FontSize" Value="11.5"/>
    <Setter Property="RowHeight" Value="30"/>
    <Setter Property="RowHeaderWidth" Value="0"/>
    <Setter Property="ColumnHeaderHeight" Value="30"/>
  </Style>
  <Style TargetType="{x:Type prim:DataGridColumnHeader}">
    <Setter Property="Background" Value="{StaticResource Panel2}"/>
    <Setter Property="Foreground" Value="{StaticResource Muted}"/>
    <Setter Property="Padding" Value="8,6"/>
    <Setter Property="BorderBrush" Value="{StaticResource Rule}"/>
    <Setter Property="BorderThickness" Value="0,0,1,1"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="FontSize" Value="11.5"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type prim:DataGridColumnHeader}">
          <Grid>
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
            </Border>
            <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Width="6" Cursor="SizeWE" Opacity="0"/>
            <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left" Width="6" Cursor="SizeWE" Opacity="0"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="DataGridRow">
    <Setter Property="Background" Value="{StaticResource Panel}"/>
    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource Panel2}"/></Trigger>
      <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource Selection}"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="DataGridCell">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="2,0"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridCell">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource Selection}"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="ListView">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
  </Style>
  <Style TargetType="ListViewItem">
    <Setter Property="Padding" Value="10,8"/>
    <Setter Property="Margin" Value="0,0,0,2"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListViewItem">
          <Border x:Name="b" Background="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Hover}"/></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource AccentTint}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ListBox">
    <Setter Property="Background" Value="{StaticResource Panel}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Frame}"/>
    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
  </Style>
  <Style TargetType="ListBoxItem">
    <Setter Property="Padding" Value="10,6"/>
    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="b" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="3,1">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Hover}"/></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource AccentTint}"/><Setter Property="Foreground" Value="{StaticResource AccentInk}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ToolTip">
    <Setter Property="Background" Value="{StaticResource Ink}"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="10,7"/>
    <Setter Property="FontSize" Value="11.5"/>
    <Setter Property="HasDropShadow" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" MaxWidth="420">
            <ContentPresenter TextBlock.Foreground="White" TextBlock.FontSize="11.5">
              <ContentPresenter.Resources>
                <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Foreground" Value="White"/></Style>
              </ContentPresenter.Resources>
            </ContentPresenter>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
