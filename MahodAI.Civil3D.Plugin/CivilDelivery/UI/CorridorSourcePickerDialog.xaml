<Window x:Class="MahodAI.Civil3D.Plugin.CivilDelivery.UI.CorridorSourcePickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="בחירת מדידת קורידורים לכתב הכמויות"
        Width="720" Height="460" MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="#FFF0F2F5" Foreground="#FF1C2420"
        FontFamily="./Fonts/#Rubik, Segoe UI, Arial" FontSize="12.5" UseLayoutRounding="True"
        ShowInTaskbar="False">

  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="CivilDeliveryTheme.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <DockPanel Margin="16">

    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
      <TextBlock x:Name="Headline" Style="{StaticResource DialogTitle}"/>
      <TextBlock Style="{StaticResource MutedText}" Margin="0,3,0,0" TextWrapping="Wrap"
                 Text="בחר מאיזה שרטוט נלקחים פרקים &#x200E;51.01–51.04&#x200E; (חישוף, עפר, מצעים, אספלט). אין בחירה אוטומטית של המדידה האחרונה — מדידת ניסוי בשרטוט אחר לא תחליף את מקור האומדן."/>
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
      <Button Content="ביטול" IsCancel="True" Click="OnCancel" Margin="6,0,0,0"/>
      <Button x:Name="BtnOk" Content="אישור" Style="{StaticResource PrimaryButton}" IsDefault="True" IsEnabled="False" Click="OnOk" Margin="6,0,0,0"/>
    </StackPanel>

    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource MutedText}" Margin="2,8,2,0" TextWrapping="Wrap"
               Text="מהשרטוט שנבחר נלקחת המדידה האחרונה שלו בלבד. אם היא אינה תקפה (השרטוט השתנה מאז, קובץ חסר) — הייצוא ייעצר ולא ייווצר קובץ; יש למדוד מחדש את השרטוט שנבחר. אין מעבר למדידה אחרת. הבחירה חלה על הייצוא הזה ונרשמת בראיות הריצה."/>

    <Border Style="{StaticResource Card}" Padding="6">
      <ListView x:Name="Candidates" SelectionMode="Single" SelectionChanged="OnSelectionChanged" MouseDoubleClick="OnRowDoubleClick">
        <ListView.ItemTemplate>
          <DataTemplate>
            <StackPanel ToolTip="{Binding FullPath}">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{Binding Folder}" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
              <TextBlock Text="{Binding Evidence}" Foreground="{StaticResource AccentInk}" TextWrapping="Wrap" Margin="0,2,0,0"/>
            </StackPanel>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
    </Border>

  </DockPanel>
</Window>
