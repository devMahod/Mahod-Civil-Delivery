<Window x:Class="MahodAI.Civil3D.Plugin.CivilDelivery.UI.PriceBookMappingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="טעינת מחירון — בדיקה לפני רישום"
        Width="820" Height="640" MinWidth="560" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="#FF141821" Foreground="#FFE6E9EF"
        FontFamily="Segoe UI" FontSize="12"
        ShowInTaskbar="False">

  <Window.Resources>
    <SolidColorBrush x:Key="Panel"  Color="#FF1C2230"/>
    <SolidColorBrush x:Key="Line"   Color="#FF2C3444"/>
    <SolidColorBrush x:Key="Accent" Color="#FF3B82F6"/>
    <SolidColorBrush x:Key="Muted"  Color="#FF9AA4B2"/>
    <SolidColorBrush x:Key="Warn"   Color="#FFF59E0B"/>

    <Style TargetType="Button">
      <Setter Property="Background" Value="{StaticResource Panel}"/>
      <Setter Property="Foreground" Value="#FFE6E9EF"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,6"/>
      <Setter Property="Margin" Value="6,0,0,0"/>
      <Setter Property="MinWidth" Value="96"/>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource Accent}"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style x:Key="MutedText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>
    <Style x:Key="Field" TargetType="StackPanel">
      <Setter Property="Orientation" Value="Horizontal"/>
      <Setter Property="Margin" Value="0,0,14,6"/>
    </Style>
  </Window.Resources>

  <DockPanel Margin="14">

    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <TextBlock x:Name="Headline" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <TextBlock Style="{StaticResource MutedText}" Margin="0,3,0,0" TextWrapping="Wrap"
                 Text="זה מה שהכלי קרא מהקובץ. אם הגיליון, שורת הכותרת או העמודות לא נכונים — בחר אחרים ולחץ &quot;בדוק בחירה&quot;. שום דבר לא נרשם לפני &quot;אשר ורשום&quot;."/>
    </StackPanel>

    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
      <StackPanel Style="{StaticResource Field}">
        <TextBlock Style="{StaticResource FieldLabel}" Text="גיליון"/>
        <ComboBox x:Name="SheetBox" MinWidth="170" SelectionChanged="OnSheetChanged" AutomationProperties.Name="גיליון"/>
      </StackPanel>
      <StackPanel Style="{StaticResource Field}">
        <TextBlock Style="{StaticResource FieldLabel}" Text="שורת כותרת"/>
        <TextBox x:Name="HeaderRowBox" Width="70" FlowDirection="LeftToRight" VerticalContentAlignment="Center"
                 TextChanged="OnHeaderRowChanged" AutomationProperties.Name="שורת כותרת"/>
      </StackPanel>
    </WrapPanel>

    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
      <StackPanel Style="{StaticResource Field}">
        <TextBlock Style="{StaticResource FieldLabel}" Text="סעיף"/>
        <ComboBox x:Name="CodeBox" MinWidth="140" SelectionChanged="OnColumnChanged" AutomationProperties.Name="עמודת סעיף"/>
      </StackPanel>
      <StackPanel Style="{StaticResource Field}">
        <TextBlock Style="{StaticResource FieldLabel}" Text="תיאור"/>
        <ComboBox x:Name="DescriptionBox" MinWidth="140" SelectionChanged="OnColumnChanged" AutomationProperties.Name="עמודת תיאור"/>
      </StackPanel>
      <StackPanel Style="{StaticResource Field}">
        <TextBlock Style="{StaticResource FieldLabel}" Text="יחידה"/>
        <ComboBox x:Name="UnitBox" MinWidth="140" SelectionChanged="OnColumnChanged" AutomationProperties.Name="עמודת יחידה"/>
      </StackPanel>
      <StackPanel Style="{StaticResource Field}">
        <TextBlock Style="{StaticResource FieldLabel}" Text="מחיר"/>
        <ComboBox x:Name="PriceBox" MinWidth="140" SelectionChanged="OnColumnChanged" AutomationProperties.Name="עמודת מחיר"/>
      </StackPanel>
    </WrapPanel>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
      <Button Content="ביטול" IsCancel="True" Click="OnCancel"/>
      <Button x:Name="BtnCheck" Content="בדוק בחירה" Click="OnCheck"/>
      <Button x:Name="BtnOk" Content="אשר ורשום" Style="{StaticResource PrimaryButton}" IsDefault="True" IsEnabled="False" Click="OnOk"/>
    </StackPanel>

    <TextBlock x:Name="StatusLine" DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource Warn}"/>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" MinHeight="120"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*" MinHeight="120"/>
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Style="{StaticResource MutedText}" Margin="8,6,8,4" TextWrapping="Wrap"
                     Text="תצוגה מקדימה של תחילת הגיליון. לחיצה על שורה בוחרת אותה כשורת הכותרת."/>
          <DataGrid x:Name="Preview" AutoGenerateColumns="True" IsReadOnly="True" CanUserSortColumns="False"
                    CanUserReorderColumns="False" HeadersVisibility="Column" SelectionMode="Single" SelectionUnit="FullRow"
                    Background="Transparent" RowBackground="{StaticResource Panel}" AlternatingRowBackground="#FF202838"
                    Foreground="#FFE6E9EF" BorderThickness="0" GridLinesVisibility="Vertical"
                    VerticalGridLinesBrush="{StaticResource Line}" EnableRowVirtualization="True"
                    MaxColumnWidth="260" SelectionChanged="OnPreviewRowSelected" AutomationProperties.Name="תצוגה מקדימה של הגיליון"/>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" Background="Transparent"/>

      <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4">
        <TextBox x:Name="SummaryBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 Background="Transparent" Foreground="#FFE6E9EF" BorderThickness="0" Padding="8"
                 AutomationProperties.Name="סיכום הקריאה"/>
      </Border>
    </Grid>

  </DockPanel>
</Window>
