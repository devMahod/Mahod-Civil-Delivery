<Window x:Class="MahodAI.Civil3D.Plugin.CivilDelivery.UI.TrafficDirectionDecisionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="כיווני נסיעה לאצוות חתכים" Width="980" Height="620"
        MinWidth="820" MinHeight="500" WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft" ShowInTaskbar="False"
        Background="#FF141821" Foreground="#FFE6E9EF"
        FontFamily="Segoe UI" FontSize="12">
  <Window.Resources>
    <SolidColorBrush x:Key="Panel" Color="#FF1C2230"/>
    <SolidColorBrush x:Key="Line" Color="#FF2C3444"/>
    <SolidColorBrush x:Key="Accent" Color="#FF3B82F6"/>
    <SolidColorBrush x:Key="Muted" Color="#FF9AA4B2"/>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource Panel}"/>
      <Setter Property="Foreground" Value="#FFE6E9EF"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="Padding" Value="7,5"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#FF141821"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="Padding" Value="5,3"/>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="#FF141821"/>
      <Setter Property="Padding" Value="8,4"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="Margin" Value="6,0,0,0"/>
      <Setter Property="Background" Value="{StaticResource Panel}"/>
      <Setter Property="Foreground" Value="#FFE6E9EF"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.65"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#FF232B3B"/>
      <Setter Property="Foreground" Value="#FFE6E9EF"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="0,0,1,1"/>
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="Foreground" Value="#FFE6E9EF"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#FF2A3B5C"/>
          <Setter Property="Foreground" Value="#FFE6E9EF"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="WrappedCellText" TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="5,3"/>
    </Style>
    <Style x:Key="NumericCellText" TargetType="TextBlock">
      <Setter Property="FlowDirection" Value="LeftToRight"/>
      <Setter Property="Margin" Value="5,3"/>
    </Style>
  </Window.Resources>

  <DockPanel Margin="16">
    <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" Padding="11"
            BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4"
            Margin="0,0,0,9">
      <StackPanel>
        <TextBlock x:Name="SubjectTitle" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock x:Name="SubjectDetail" Foreground="{StaticResource Muted}"
                   Margin="0,4,0,0" TextWrapping="Wrap"/>
        <TextBlock Foreground="#FFE0A44C" Margin="0,7,0,0" TextWrapping="Wrap"
                   Text="כיוון נבחר ביחס לציר, לא לפי הצד בחתך. בעריכת כיוון קיים יש להשוות לחץ המקור; בחירה וסימון מפורשים מאשרים כיוון חדש רק לרצועה הנוכחית. ביטול אינו שומר שינויים."/>
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" Padding="9"
            BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4"
            Margin="0,0,0,9">
      <StackPanel>
      <DockPanel>
        <Button DockPanel.Dock="Left" Content="החל כיוון על השורות המודגשות"
                Click="OnApplyFlowToSelected"/>
        <TextBlock DockPanel.Dock="Right" Text="כיוון לשורות המודגשות:" VerticalAlignment="Center"/>
        <ComboBox x:Name="BatchFlowBox" DisplayMemberPath="Label" MinWidth="250" Margin="8,0,8,0"/>
      </DockPanel>
      <TextBlock Foreground="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"
                 Text="הדגשת שורות: לחיצה על השורה, ו-Ctrl או Shift לכמה שורות. תיבת «אישור» קובעת רק אילו שורות יישמרו, לא על אילו שורות יוחל הכיוון. ראיית המקור ונתוני התחנה זמינים גם בגלילה האופקית בתחתית הטבלה."/>
      </StackPanel>
    </Border>

    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <DockPanel Margin="0,0,0,9">
        <TextBlock Text="מאשר/ת:" VerticalAlignment="Center"/>
        <TextBox x:Name="ApproverBox" Margin="8,0,0,0" MinWidth="210"
                 TextChanged="OnInputChanged"/>
      </DockPanel>
      <TextBlock x:Name="ValidationText" Margin="0,0,0,6" Foreground="#FFE0A44C" TextWrapping="Wrap"/>
      <DockPanel LastChildFill="False">
        <Button DockPanel.Dock="Right" Content="ביטול" Click="OnCancel" IsCancel="True"/>
        <Button x:Name="BtnSave" DockPanel.Dock="Right" Content="אשר את כל כיווני הנסיעה"
                Click="OnSave" IsDefault="True" Background="{StaticResource Accent}"
                Foreground="White" FontWeight="SemiBold"/>
      </DockPanel>
    </StackPanel>

    <DataGrid x:Name="DirectionsGrid" AutoGenerateColumns="False" CanUserAddRows="False"
              IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
              SelectionMode="Extended" SelectionUnit="FullRow"
              Background="{StaticResource Panel}" Foreground="#FFE6E9EF"
              RowBackground="{StaticResource Panel}" AlternatingRowBackground="#FF202736"
              BorderBrush="{StaticResource Line}"
              MinRowHeight="34" ScrollViewer.HorizontalScrollBarVisibility="Auto">
      <DataGrid.Columns>
        <DataGridTemplateColumn x:Name="ApprovalColumn" Header="אישור" Width="60" MinWidth="60" Visibility="Collapsed">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <CheckBox IsChecked="{Binding IsApproved, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="חתך" Binding="{Binding Section}" Width="105" MinWidth="105" IsReadOnly="True"/>
        <DataGridTextColumn Header="רצועה" Binding="{Binding Strip}" Width="110" MinWidth="110" IsReadOnly="True"/>
        <DataGridTextColumn Header="כיוון נוכחי / מקור" Binding="{Binding CurrentDirection}" Width="165" MinWidth="165"
                            IsReadOnly="True" ElementStyle="{StaticResource WrappedCellText}"/>
        <DataGridTemplateColumn Header="כיוון מאושר" Width="*" MinWidth="250">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <ComboBox ItemsSource="{Binding Choices}" DisplayMemberPath="Label"
                        SelectedItem="{Binding SelectedChoice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        SelectionChanged="OnInputChanged"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="תוואי" Binding="{Binding Alignment}" Width="90" MinWidth="90" IsReadOnly="True"/>
        <DataGridTextColumn Header="תחנה" Binding="{Binding Station}" Width="80" MinWidth="80" IsReadOnly="True" ElementStyle="{StaticResource NumericCellText}"/>
        <DataGridTextColumn Header="אמצע" Binding="{Binding Offset}" Width="75" MinWidth="75" IsReadOnly="True" ElementStyle="{StaticResource NumericCellText}"/>
        <DataGridTextColumn Header="ראיה" Binding="{Binding Evidence}" Width="280" MinWidth="280" IsReadOnly="True" ElementStyle="{StaticResource WrappedCellText}">
          <DataGridTextColumn.CellStyle>
            <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
              <Setter Property="ToolTip" Value="{Binding EvidenceCode}"/>
            </Style>
          </DataGridTextColumn.CellStyle>
        </DataGridTextColumn>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
