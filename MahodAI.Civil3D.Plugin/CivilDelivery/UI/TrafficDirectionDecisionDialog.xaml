<Window x:Class="MahodAI.Civil3D.Plugin.CivilDelivery.UI.TrafficDirectionDecisionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="כיווני נסיעה לאצוות חתכים" Width="980" Height="620"
        MinWidth="820" MinHeight="500" WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft" ShowInTaskbar="False"
        Background="#FFF0F2F5" Foreground="#FF1C2420"
        FontFamily="./Fonts/#Rubik, Segoe UI, Arial" FontSize="12.5" UseLayoutRounding="True">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="CivilDeliveryTheme.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <!-- The choice boxes keep dark text in both the list and the closed box (the layout contract pins the value). -->
      <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="#FF141821"/>
        <Setter Property="BorderBrush" Value="{StaticResource Frame}"/>
        <Setter Property="Padding" Value="10,4,8,4"/>
        <Setter Property="MinHeight" Value="30"/>
      </Style>
      <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
        <Setter Property="Foreground" Value="#FF141821"/>
        <Setter Property="Padding" Value="8,4"/>
      </Style>
    </ResourceDictionary>
  </Window.Resources>

  <DockPanel Margin="16">
    <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,9">
      <StackPanel>
        <TextBlock x:Name="SubjectTitle" Style="{StaticResource CardTitle}" TextWrapping="Wrap"/>
        <TextBlock x:Name="SubjectDetail" Style="{StaticResource SoftText}"
                   Margin="0,4,0,0" TextWrapping="Wrap"/>
        <TextBlock Foreground="{StaticResource Warn}" Margin="0,7,0,0" TextWrapping="Wrap"
                   Text="כיוון נבחר ביחס לציר, לא לפי הצד בחתך. בעריכת כיוון קיים יש להשוות לחץ המקור; בחירה וסימון מפורשים מאשרים כיוון חדש רק לרצועה הנוכחית. ביטול אינו שומר שינויים."/>
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,9">
      <StackPanel>
      <DockPanel>
        <Button DockPanel.Dock="Left" Content="החל כיוון על השורות המודגשות" Margin="0,0,8,0"
                Click="OnApplyFlowToSelected"/>
        <TextBlock DockPanel.Dock="Right" Text="כיוון לשורות המודגשות:" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
        <ComboBox x:Name="BatchFlowBox" DisplayMemberPath="Label" MinWidth="250" Margin="8,0,8,0"/>
      </DockPanel>
      <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0" TextWrapping="Wrap"
                 Text="הדגשת שורות: לחיצה על השורה, ו-Ctrl או Shift לכמה שורות. תיבת «אישור» קובעת רק אילו שורות יישמרו, לא על אילו שורות יוחל הכיוון. ראיית המקור ונתוני התחנה זמינים גם בגלילה האופקית בתחתית הטבלה."/>
      </StackPanel>
    </Border>

    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <DockPanel Margin="0,0,0,9">
        <TextBlock Text="מאשר/ת" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
        <TextBox x:Name="ApproverBox" Margin="8,0,0,0" MinWidth="210"
                 TextChanged="OnInputChanged"/>
      </DockPanel>
      <TextBlock x:Name="ValidationText" Margin="2,0,2,6" Foreground="{StaticResource Warn}" TextWrapping="Wrap"/>
      <DockPanel LastChildFill="False">
        <Button DockPanel.Dock="Right" Content="ביטול" Click="OnCancel" IsCancel="True" Margin="6,0,0,0"/>
        <Button x:Name="BtnSave" DockPanel.Dock="Right" Content="אשר את כל כיווני הנסיעה" Margin="6,0,0,0"
                Click="OnSave" IsDefault="True" Style="{StaticResource PrimaryButton}"/>
      </DockPanel>
    </StackPanel>

    <Border Style="{StaticResource Card}" Padding="6">
    <DataGrid x:Name="DirectionsGrid" AutoGenerateColumns="False" CanUserAddRows="False"
              IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
              SelectionMode="Extended" SelectionUnit="FullRow" BorderThickness="0"
              MinRowHeight="34" ScrollViewer.HorizontalScrollBarVisibility="Auto">
      <DataGrid.Columns>
        <DataGridTemplateColumn x:Name="ApprovalColumn" Header="אישור" Width="60" MinWidth="60" Visibility="Collapsed">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <CheckBox IsChecked="{Binding IsApproved, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="חתך" Binding="{Binding Section}" Width="105" MinWidth="105" IsReadOnly="True"/>
        <DataGridTextColumn Header="רצועה" Binding="{Binding Strip}" Width="110" MinWidth="110" IsReadOnly="True"/>
        <DataGridTextColumn Header="כיוון נוכחי / מקור" Binding="{Binding CurrentDirection}" Width="165" MinWidth="165"
                            IsReadOnly="True" ElementStyle="{StaticResource WrappedCellText}"/>
        <DataGridTemplateColumn Header="כיוון מאושר" Width="*" MinWidth="250">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <ComboBox ItemsSource="{Binding Choices}" DisplayMemberPath="Label" Margin="2"
                        SelectedItem="{Binding SelectedChoice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        SelectionChanged="OnInputChanged"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="תוואי" Binding="{Binding Alignment}" Width="90" MinWidth="90" IsReadOnly="True"/>
        <DataGridTextColumn Header="תחנה" Binding="{Binding Station}" Width="80" MinWidth="80" IsReadOnly="True" ElementStyle="{StaticResource NumericCellText}"/>
        <DataGridTextColumn Header="אמצע" Binding="{Binding Offset}" Width="75" MinWidth="75" IsReadOnly="True" ElementStyle="{StaticResource NumericCellText}"/>
        <DataGridTextColumn Header="ראיה" Binding="{Binding Evidence}" Width="280" MinWidth="280" IsReadOnly="True" ElementStyle="{StaticResource WrappedCellText}">
          <DataGridTextColumn.CellStyle>
            <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
              <Setter Property="ToolTip" Value="{Binding EvidenceCode}"/>
            </Style>
          </DataGridTextColumn.CellStyle>
        </DataGridTextColumn>
      </DataGrid.Columns>
    </DataGrid>
    </Border>
  </DockPanel>
</Window>
