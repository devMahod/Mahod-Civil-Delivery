<Window x:Class="MahodAI.Civil3D.Plugin.CivilDelivery.UI.ProvenMappingBatchDecisionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="אישור מיפויים חד־משמעיים" Width="1180" Height="720"
        MinWidth="920" MinHeight="560" WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft" ShowInTaskbar="False"
        Background="#FF141821" Foreground="#FFE6E9EF"
        FontFamily="Segoe UI" FontSize="12">
  <Window.Resources>
    <SolidColorBrush x:Key="Panel" Color="#FF1C2230"/>
    <SolidColorBrush x:Key="Line" Color="#FF2C3444"/>
    <SolidColorBrush x:Key="Accent" Color="#FF3B82F6"/>
    <SolidColorBrush x:Key="Muted" Color="#FF9AA4B2"/>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource Panel}"/>
      <Setter Property="Foreground" Value="#FFE6E9EF"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="Padding" Value="7,5"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="Margin" Value="6,0,0,0"/>
      <Setter Property="Background" Value="{StaticResource Panel}"/>
      <Setter Property="Foreground" Value="#FFE6E9EF"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.65"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource Accent}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="CellText" TargetType="TextBlock">
      <Setter Property="Margin" Value="5,3"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="LtrCellText" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
      <Setter Property="FlowDirection" Value="LeftToRight"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#FF232B3B"/>
      <Setter Property="Foreground" Value="#FFE6E9EF"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="0,0,1,1"/>
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="Foreground" Value="#FFE6E9EF"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#FF2A3B5C"/>
          <Setter Property="Foreground" Value="#FFE6E9EF"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <DockPanel Margin="14">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="בדיקה מרוכזת לפני אישור מיפויים" FontSize="17" FontWeight="SemiBold"/>
      <TextBlock x:Name="SummaryText" Foreground="{StaticResource Muted}"
                 Margin="0,4,0,10" TextWrapping="Wrap"/>
      <Border Background="#FF2A2115" BorderBrush="#FFE0A44C" BorderThickness="1"
              Padding="9" CornerRadius="4" Margin="0,0,0,10">
        <TextBlock TextWrapping="Wrap"
                   Text="זו אינה השלמה אוטומטית. הרשימה כוללת רק קבוצות עם מקור מדידה אחיד, כלל מדויק ומוגרס, סעיף ויחידה תואמים ומחיר נעוץ — וללא ממצאי כפל, חפיפה, מדידה כושלת, ממד מעורב או חלופת פוליליין סגור. יש לבדוק כל שורה; יתר ההצעות נשארות לבדיקה פרטנית."/>
      </Border>
      <TextBlock Foreground="{StaticResource Muted}" Margin="0,0,0,6" TextWrapping="Wrap"
                 Text="יש לבדוק גם את הראיה והמפתח המדויק — העמודות הנוספות זמינות בגלילה האופקית בתחתית הטבלה."/>
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <CheckBox x:Name="ConfirmBox" Margin="0,0,0,10" Foreground="#FFE6E9EF"
                Checked="OnInputChanged" Unchecked="OnInputChanged">
        <TextBlock TextWrapping="Wrap"
                   Text="בדקתי את כל השורות בטבלה ואני מאשר במפורש את שיוך כל מפתח המדידה לסעיף וליחידה המוצגים."/>
      </CheckBox>
      <DockPanel Margin="0,0,0,8">
        <TextBlock Text="מאשר:" VerticalAlignment="Center"/>
        <TextBox x:Name="ApproverBox" Margin="8,0,0,0" MinWidth="240"
                 TextChanged="OnInputChanged"/>
      </DockPanel>
      <TextBlock x:Name="ValidationText" Margin="0,0,0,6" Foreground="#FFE0A44C" TextWrapping="Wrap"/>
      <DockPanel LastChildFill="False">
        <Button DockPanel.Dock="Right" Content="ביטול" Click="OnCancel" IsCancel="True"/>
        <Button x:Name="BtnSave" DockPanel.Dock="Right" Content="אשר ושמור את כל השורות"
                Click="OnSave" IsDefault="True" Style="{StaticResource PrimaryButton}"/>
      </DockPanel>
    </StackPanel>

    <DataGrid x:Name="CandidatesGrid" AutoGenerateColumns="False" IsReadOnly="True"
              CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
              Background="{StaticResource Panel}" Foreground="#FFE6E9EF"
              BorderBrush="{StaticResource Line}" RowBackground="{StaticResource Panel}"
              AlternatingRowBackground="#FF202838" HorizontalGridLinesBrush="{StaticResource Line}"
              ScrollViewer.HorizontalScrollBarVisibility="Auto">
      <DataGrid.Columns>
        <DataGridTextColumn Header="שכבה" Binding="{Binding Layer}" Width="1.5*" MinWidth="145"
                            ElementStyle="{StaticResource LtrCellText}"/>
        <DataGridTextColumn Header="סוג מדידה" Binding="{Binding Approval.MeasurementKind}" Width="95" MinWidth="95"
                            ElementStyle="{StaticResource LtrCellText}"/>
        <DataGridTextColumn Header="עצמים" Binding="{Binding ObjectCount}" Width="65" MinWidth="65"
                            ElementStyle="{StaticResource LtrCellText}"/>
        <DataGridTextColumn Header="כמות" Binding="{Binding TotalQuantity}" Width="85" MinWidth="85"
                            ElementStyle="{StaticResource LtrCellText}"/>
        <DataGridTextColumn Header="יחידה" Binding="{Binding Unit}" Width="75" MinWidth="75"
                            ElementStyle="{StaticResource CellText}"/>
        <DataGridTextColumn Header="סעיף" Binding="{Binding Approval.CatalogCode}" Width="105" MinWidth="105"
                            ElementStyle="{StaticResource LtrCellText}"/>
        <DataGridTextColumn Header="תיאור מחירון" Binding="{Binding CatalogDescription}" Width="2*" MinWidth="220"
                            ElementStyle="{StaticResource CellText}"/>
        <DataGridTextColumn Header="מחיר" Binding="{Binding Price}" Width="80" MinWidth="80"
                            ElementStyle="{StaticResource LtrCellText}"/>
        <DataGridTextColumn Header="ראיה" Binding="{Binding EvidenceSummary}" Width="2*" MinWidth="210"
                            ElementStyle="{StaticResource CellText}"/>
        <DataGridTextColumn Header="מפתח מדויק" Binding="{Binding Approval.RuleKey}" Width="2*" MinWidth="220"
                            ElementStyle="{StaticResource LtrCellText}"/>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
