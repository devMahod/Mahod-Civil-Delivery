<Window x:Class="MahodAI.Civil3D.Plugin.CivilDelivery.UI.ProvenMappingBatchDecisionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="אישור מיפויים חד־משמעיים" Width="1180" Height="720"
        MinWidth="920" MinHeight="560" WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft" ShowInTaskbar="False"
        Background="#FFF0F2F5" Foreground="#FF1C2420"
        FontFamily="./Fonts/#Rubik, Segoe UI, Arial" FontSize="12.5" UseLayoutRounding="True">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="CivilDeliveryTheme.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="בדיקה מרוכזת לפני אישור מיפויים" Style="{StaticResource DialogTitle}"/>
      <TextBlock x:Name="SummaryText" Style="{StaticResource MutedText}"
                 Margin="0,4,0,10" TextWrapping="Wrap"/>
      <Border Background="{StaticResource ReviewTint}" Padding="12,9" CornerRadius="12" Margin="0,0,0,10">
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Ink}"
                   Text="זו אינה השלמה אוטומטית. הרשימה כוללת רק קבוצות עם מקור מדידה אחיד, כלל מדויק ומוגרס, סעיף ויחידה תואמים ומחיר נעוץ — וללא ממצאי כפל, חפיפה, מדידה כושלת, ממד מעורב או חלופת פוליליין סגור. יש לבדוק כל שורה; יתר ההצעות נשארות לבדיקה פרטנית."/>
      </Border>
      <TextBlock Style="{StaticResource MutedText}" Margin="2,0,2,6" TextWrapping="Wrap"
                 Text="יש לבדוק גם את הראיה והמפתח המדויק — העמודות הנוספות זמינות בגלילה האופקית בתחתית הטבלה."/>
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <CheckBox x:Name="ConfirmBox" Margin="2,0,2,10" Foreground="#FF1C2420"
                Checked="OnInputChanged" Unchecked="OnInputChanged">
        <TextBlock TextWrapping="Wrap"
                   Text="בדקתי את כל השורות בטבלה ואני מאשר במפורש את שיוך כל מפתח המדידה לסעיף וליחידה המוצגים."/>
      </CheckBox>
      <DockPanel Margin="0,0,0,8">
        <TextBlock Text="מאשר" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
        <TextBox x:Name="ApproverBox" Margin="8,0,0,0" MinWidth="240"
                 TextChanged="OnInputChanged"/>
      </DockPanel>
      <TextBlock x:Name="ValidationText" Margin="2,0,2,6" Foreground="{StaticResource Warn}" TextWrapping="Wrap"/>
      <DockPanel LastChildFill="False">
        <Button DockPanel.Dock="Right" Content="ביטול" Click="OnCancel" IsCancel="True" Margin="6,0,0,0"/>
        <Button x:Name="BtnSave" DockPanel.Dock="Right" Content="אשר ושמור את כל השורות" Margin="6,0,0,0"
                Click="OnSave" IsDefault="True" Style="{StaticResource PrimaryButton}"/>
      </DockPanel>
    </StackPanel>

    <Border Style="{StaticResource Card}" Padding="6">
    <DataGrid x:Name="CandidatesGrid" AutoGenerateColumns="False" IsReadOnly="True"
              CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
              HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0"
              ScrollViewer.HorizontalScrollBarVisibility="Auto">
      <DataGrid.Columns>
        <DataGridTextColumn Header="שכבה" Binding="{Binding Layer}" Width="1.5*" MinWidth="145"
                            ElementStyle="{StaticResource LtrCellText}"/>
        <DataGridTextColumn Header="סוג מדידה" Binding="{Binding Approval.MeasurementKind}" Width="95" MinWidth="95"
                            ElementStyle="{StaticResource LtrCellText}"/>
        <DataGridTextColumn Header="עצמים" Binding="{Binding ObjectCount}" Width="65" MinWidth="65"
                            ElementStyle="{StaticResource LtrCellText}"/>
        <DataGridTextColumn Header="כמות" Binding="{Binding TotalQuantity}" Width="85" MinWidth="85"
                            ElementStyle="{StaticResource LtrCellText}"/>
        <DataGridTextColumn Header="יחידה" Binding="{Binding Unit}" Width="75" MinWidth="75"
                            ElementStyle="{StaticResource CellText}"/>
        <DataGridTextColumn Header="סעיף" Binding="{Binding Approval.CatalogCode}" Width="105" MinWidth="105"
                            ElementStyle="{StaticResource LtrCellText}"/>
        <DataGridTextColumn Header="תיאור מחירון" Binding="{Binding CatalogDescription}" Width="2*" MinWidth="220"
                            ElementStyle="{StaticResource CellText}"/>
        <DataGridTextColumn Header="מחיר" Binding="{Binding Price}" Width="80" MinWidth="80"
                            ElementStyle="{StaticResource LtrCellText}"/>
        <DataGridTextColumn Header="ראיה" Binding="{Binding EvidenceSummary}" Width="2*" MinWidth="210"
                            ElementStyle="{StaticResource CellText}"/>
        <DataGridTextColumn Header="מפתח מדויק" Binding="{Binding Approval.RuleKey}" Width="2*" MinWidth="220"
                            ElementStyle="{StaticResource LtrCellText}"/>
      </DataGrid.Columns>
    </DataGrid>
    </Border>
  </DockPanel>
</Window>
