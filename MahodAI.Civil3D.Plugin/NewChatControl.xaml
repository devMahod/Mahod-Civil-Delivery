<UserControl x:Class="MahodAI.Civil3D.Plugin.NewChatControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="450"
             x:Name="RootControl">

    <UserControl.Resources>
        <!-- Color Resources - Light Mode -->
        <Color x:Key="PrimaryBackgroundColor">#EDF1F1</Color>
        <Color x:Key="SecondaryBackgroundColor">#F2F5F4</Color>
        <Color x:Key="CardBackgroundColor">#FFFFFF</Color>
        <Color x:Key="PrimaryTextColor">#15232B</Color>
        <Color x:Key="SecondaryTextColor">#6B7C82</Color>
        <Color x:Key="BorderColor">#E3E9E8</Color>
        <Color x:Key="AccentGreenColor">#2EA64C</Color>
        <Color x:Key="AccentGreenDarkColor">#1C7C38</Color>
        <Color x:Key="GreenTintColor">#EAF7EE</Color>
        <Color x:Key="GreenTintBorderColor">#CFE9D6</Color>
        <Color x:Key="AccentBlueColor">#1B2A30</Color>
        <Color x:Key="AccentBlueLightColor">#33454C</Color>
        <Color x:Key="SuccessColor">#2EA64C</Color>
        <Color x:Key="ErrorColor">#D14343</Color>

        <!-- Brushes -->
        <SolidColorBrush x:Key="PrimaryBackgroundBrush" Color="{StaticResource PrimaryBackgroundColor}"/>
        <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="{StaticResource SecondaryBackgroundColor}"/>
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}"/>
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
        <SolidColorBrush x:Key="AccentGreenBrush" Color="{StaticResource AccentGreenColor}"/>
        <SolidColorBrush x:Key="AccentGreenDarkBrush" Color="{StaticResource AccentGreenDarkColor}"/>
        <SolidColorBrush x:Key="GreenTintBrush" Color="{StaticResource GreenTintColor}"/>
        <SolidColorBrush x:Key="GreenTintBorderBrush" Color="{StaticResource GreenTintBorderColor}"/>
        <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource AccentBlueColor}"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>

        <!-- Line-icon geometries (Lucide-style, 24x24) — match the HTML reference -->
        <Geometry x:Key="IconFileText">M14 2 H6 a2 2 0 0 0 -2 2 v16 a2 2 0 0 0 2 2 h12 a2 2 0 0 0 2 -2 V8 z M14 2 v6 h6 M16 13 H8 M16 17 H8 M10 9 H8</Geometry>
        <Geometry x:Key="IconLayers">M12 2 L2 7 l10 5 10 -5 -10 -5 z M2 17 l10 5 10 -5 M2 12 l10 5 10 -5</Geometry>
        <Geometry x:Key="IconPencil">M12 20 h9 M16.5 3.5 a2.121 2.121 0 0 1 3 3 L7 19 l-4 1 1 -4 L16.5 3.5 z</Geometry>
        <Geometry x:Key="IconPaperclip">M21.44 11.05 l-9.19 9.19 a6 6 0 0 1 -8.49 -8.49 l9.19 -9.19 a4 4 0 0 1 5.66 5.66 l-9.2 9.19 a2 2 0 0 1 -2.83 -2.83 l8.49 -8.48</Geometry>
        <Geometry x:Key="IconMic">M12 2 a3 3 0 0 0 -3 3 v7 a3 3 0 0 0 6 0 V5 a3 3 0 0 0 -3 -3 z M19 10 v2 a7 7 0 0 1 -14 0 v-2 M12 19 v3</Geometry>
        <Geometry x:Key="IconArrowLeft">M19 12 H5 M12 19 l-7 -7 7 -7</Geometry>
        <Geometry x:Key="IconUser">M5 20 v-1 a5 5 0 0 1 5 -5 h4 a5 5 0 0 1 5 5 v1 M12 11 a4 4 0 1 0 0 -8 a4 4 0 1 0 0 8 z</Geometry>

        <!-- Header Gradient -->
        <LinearGradientBrush x:Key="HeaderGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1E3A5F" Offset="0"/>
            <GradientStop Color="#2C5282" Offset="1"/>
        </LinearGradientBrush>

        <!-- Send Button Gradient -->
        <LinearGradientBrush x:Key="SendButtonGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#2EA64C" Offset="0"/>
            <GradientStop Color="#1C8C40" Offset="1"/>
        </LinearGradientBrush>

        <!-- Connection Dot Pulse Animation -->
        <Storyboard x:Key="PulseAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                           From="1" To="0.5" Duration="0:0:1"
                           AutoReverse="True"/>
        </Storyboard>

        <!-- Action Button Style — white card with green label (reference look) -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <!-- DynamicResource (not Static) so ApplyTheme's brush-resource
                 swap actually reaches these action buttons in dark mode. -->
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentGreenDarkBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Padding" Value="9,8"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.06"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource GreenTintBrush}"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{DynamicResource GreenTintBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- User-menu hover highlight. Theme-swapped at runtime (ApplyTheme) so the
             selected/hovered row reads as a BRIGHTER tint, never a darker one. -->
        <SolidColorBrush x:Key="MenuHoverBrush" Color="#EAF7EE"/>
        <!-- Subtle hover for icon-only buttons (attach/mic). Theme-swapped in ApplyTheme. -->
        <SolidColorBrush x:Key="SubtleHoverBrush" Color="#E7ECEB"/>

        <!-- Shared style for the user-menu rows: gives every row a consistent,
             theme-aware hover so the dropdown highlight is legible in dark mode. -->
        <Style x:Key="MenuItemStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="Margin" Value="6,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FlowDirection" Value="RightToLeft"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="MiBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MiBorder" Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid x:Name="MainGrid" Background="{StaticResource PrimaryBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>      <!-- Header -->
            <RowDefinition Height="*"/>       <!-- Chat Area -->
            <RowDefinition Height="Auto"/>    <!-- Input Area -->
        </Grid.RowDefinitions>

        <!-- ============================================ -->
        <!-- HEADER BAR -->
        <!-- ============================================ -->
        <Border Grid.Row="0"
                x:Name="HeaderBorder"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>     <!-- Logo & Title (Right in RTL) -->
                    <ColumnDefinition Width="Auto"/> <!-- Actions (Left in RTL) -->
                </Grid.ColumnDefinitions>

                <!-- Logo Section — full "מהוד הנדסה · עוזר AI" banner (moved here from
                     the chat box). The old "mp + MahodAI Assistant" text lockup was removed. -->
                <StackPanel Grid.Column="0"
                           Orientation="Horizontal"
                           VerticalAlignment="Center"
                           FlowDirection="RightToLeft">
                    <Image x:Name="HeaderLogo"
                           Height="42"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"/>
                </StackPanel>

                <!-- Actions Section -->
                <StackPanel Grid.Column="1"
                           Orientation="Horizontal"
                           VerticalAlignment="Center"
                           FlowDirection="RightToLeft">
                    <!-- Connection Status (DynamicResource so it themes in dark mode) -->
                    <Border Background="{DynamicResource GreenTintBrush}"
                            BorderBrush="{DynamicResource GreenTintBorderBrush}"
                            BorderThickness="1"
                            Padding="10,5"
                            CornerRadius="14"
                            Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                            <Ellipse x:Name="ConnectionDot"
                                    Width="8" Height="8"
                                    Fill="#FBBF24"
                                    Margin="0,0,6,0"/>
                            <TextBlock x:Name="ConnectionText"
                                      Text="מתחבר..."
                                      Foreground="{DynamicResource AccentGreenDarkBrush}"
                                      FontSize="12"
                                      FontWeight="Medium"
                                      VerticalAlignment="Center"
                                      FontFamily="Segoe UI"/>
                        </StackPanel>
                    </Border>

                    <!-- User Menu Button — pill with a dark-navy avatar icon (matches the reference) -->
                    <Button x:Name="UserMenuButton"
                            Background="{StaticResource CardBackgroundBrush}"
                            Foreground="{StaticResource PrimaryTextBrush}"
                            BorderThickness="0"
                            Padding="5,5,12,5"
                            Cursor="Hand"
                            Click="UserMenuButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="UserBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft" VerticalAlignment="Center">
                                        <!-- Dark-navy avatar (rightmost in RTL) -->
                                        <Border Width="28" Height="28" CornerRadius="14"
                                                Background="#1B2A30" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconUser}" Stretch="Uniform"
                                                  Width="15" Height="15" Stroke="White" StrokeThickness="2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="משתמש"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  FontSize="14"
                                                  FontWeight="Medium"
                                                  VerticalAlignment="Center"
                                                  Margin="8,0,8,0"
                                                  FontFamily="Segoe UI"/>
                                        <TextBlock Text="▾"
                                                  FontSize="11"
                                                  Foreground="{StaticResource SecondaryTextBrush}"
                                                  VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="UserBorder" Property="Background" Value="{StaticResource SecondaryBackgroundBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- User Menu Popup -->
                    <Popup x:Name="UserMenuPopup"
                           PlacementTarget="{Binding ElementName=UserMenuButton}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="Fade">
                        <Border x:Name="MenuPopupBorder"
                                Background="{StaticResource CardBackgroundBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                MinWidth="220"
                                Margin="0,4,0,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20"
                                                ShadowDepth="10"
                                                Opacity="0.2"/>
                            </Border.Effect>
                            <StackPanel>
                                <!-- User Info Header -->
                                <Border BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="16">
                                    <StackPanel FlowDirection="RightToLeft">
                                        <TextBlock x:Name="MenuUserName"
                                                  Text="משתמש מחובר"
                                                  FontSize="14"
                                                  FontWeight="SemiBold"
                                                  Foreground="{StaticResource PrimaryTextBrush}"/>
                                        <TextBlock x:Name="MenuUserPlan"
                                                  Text="גרסה מקצועית"
                                                  FontSize="12"
                                                  Foreground="{StaticResource SecondaryTextBrush}"
                                                  Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <!-- Menu Items — RTL rows: Hebrew text hugs the right, icon on the far left.
                                     NOTE: MenuItemStyle sets FlowDirection=RightToLeft, which MIRRORS
                                     HorizontalAlignment — "Left" here is the VISUAL RIGHT edge. -->
                                <Button x:Name="DarkModeMenuItem"
                                        Click="DarkModeMenuItem_Click"
                                        Style="{StaticResource MenuItemStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="DarkModeLabel" Grid.Column="0" Text="מצב כהה" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="DarkModeIcon" Grid.Column="1" Text="🌙" Margin="14,0,0,0" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                                <Button x:Name="SettingsMenuItem"
                                        Click="SettingsMenuItem_Click"
                                        Style="{StaticResource MenuItemStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="הגדרות" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="⚙️" Margin="14,0,0,0" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                                <Button x:Name="ProblemsOverlayMenuItem"
                                        Click="ProblemsOverlayMenuItem_Click"
                                        Style="{StaticResource MenuItemStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="בעיות על השרטוט" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="📍" Margin="14,0,0,0" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                                <Button x:Name="ClearChatMenuItem"
                                        Click="ClearChatMenuItem_Click"
                                        Style="{StaticResource MenuItemStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="נקה צ'אט" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="🗑️" Margin="14,0,0,0" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                                <Button x:Name="AboutMenuItem"
                                        Click="AboutMenuItem_Click"
                                        Style="{StaticResource MenuItemStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="אודות" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="ℹ️" Margin="14,0,0,0" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================ -->
        <!-- CHAT MESSAGES AREA (WebView2) -->
        <!-- ============================================ -->
        <Border Grid.Row="1"
                Background="{StaticResource PrimaryBackgroundBrush}"
                Margin="0">
            <wv2:WebView2 x:Name="ChatBrowser"
                         Margin="0"
                         AllowDrop="False"/>
        </Border>

        <!-- ============================================ -->
        <!-- INPUT AREA -->
        <!-- ============================================ -->
        <Border x:Name="InputAreaBorder"
                Grid.Row="2"
                Background="{StaticResource CardBackgroundBrush}"
                CornerRadius="16,16,0,0"
                Padding="16,12"
                Margin="0,-8,0,0">
            <Border.Effect>
                <DropShadowEffect Direction="90"
                                  BlurRadius="20"
                                  ShadowDepth="4"
                                  Opacity="0.08"/>
            </Border.Effect>

            <StackPanel>
                <!-- Input Row — one rounded bar: send/attach/mic grouped on the left,
                     text on the right (matches the reference design). -->
                <Border x:Name="InputTextBorder"
                        Background="{StaticResource SecondaryBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="24"
                        Padding="6,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Controls group: send (green circle) + attach + mic -->
                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    FlowDirection="LeftToRight"
                                    VerticalAlignment="Center"
                                    Margin="0,0,4,0">
                            <!-- Send / Stop share the same 40x40 spot -->
                            <Grid Width="40" Height="40">
                                <Button x:Name="SendButton"
                                        Background="{StaticResource SendButtonGradientBrush}"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        ToolTip="שלח"
                                        Click="SendButton_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="SendBorder"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="20">
                                                <Path Data="{StaticResource IconArrowLeft}" Stretch="Uniform"
                                                      Width="18" Height="18" Stroke="White" StrokeThickness="2.2"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="SendBorder" Property="RenderTransform">
                                                        <Setter.Value>
                                                            <ScaleTransform ScaleX="1.06" ScaleY="1.06"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Setter TargetName="SendBorder" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="SendBorder" Property="Background" Value="#94A3B8"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button x:Name="StopButton"
                                        Background="#DC2626"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Visibility="Collapsed"
                                        ToolTip="עצור את הבקשה"
                                        Click="StopButton_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="StopBorder"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="20">
                                                <Rectangle Width="13" Height="13"
                                                          Fill="White"
                                                          RadiusX="3" RadiusY="3"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="StopBorder" Property="Background" Value="#B91C1C"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                            <!-- Attach File -->
                            <Button x:Name="AttachFileButton"
                                    Width="38" Height="38"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Margin="3,0,0,0"
                                    ToolTip="צרף קובץ"
                                    Click="AttachFileButton_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="AttachBorder"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="19">
                                            <Path Data="{StaticResource IconPaperclip}" Stretch="Uniform"
                                                  Width="18" Height="18" Stroke="{StaticResource SecondaryTextBrush}" StrokeThickness="2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="AttachBorder" Property="Background" Value="{DynamicResource SubtleHoverBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Microphone (Voice Input) -->
                            <Button x:Name="MicButton"
                                    Width="38" Height="38"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Margin="1,0,0,0"
                                    ToolTip="הקלטה קולית"
                                    Click="MicButton_Click">
                                <Path x:Name="MicIcon" Data="{StaticResource IconMic}" Stretch="Uniform"
                                      Width="18" Height="18" Stroke="{StaticResource SecondaryTextBrush}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="MicBorder"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="19">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="MicBorder" Property="Background" Value="{DynamicResource SubtleHoverBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>

                        <!-- Text Input -->
                        <TextBox x:Name="InputTextBox"
                                Grid.Column="1"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="12,10"
                                FontSize="15"
                                FontFamily="Segoe UI"
                                Foreground="{StaticResource PrimaryTextBrush}"
                                FlowDirection="RightToLeft"
                                TextWrapping="Wrap"
                                AcceptsReturn="True"
                                AcceptsTab="False"
                                MinHeight="40"
                                MaxHeight="160"
                                VerticalScrollBarVisibility="Auto"
                                VerticalContentAlignment="Center"
                                PreviewKeyDown="InputTextBox_PreviewKeyDown"
                                AllowDrop="True"
                                PreviewDragOver="InputTextBox_PreviewDragOver"
                                Drop="InputTextBox_Drop">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <Grid>
                                                    <ScrollViewer x:Name="PART_ContentHost"
                                                                 VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="Placeholder"
                                                              Text="שאל שאלה בנושא הנדסת תחבורה..."
                                                              Foreground="{StaticResource SecondaryTextBrush}"
                                                              Padding="12,10"
                                                              FontSize="15"
                                                              FontFamily="Segoe UI"
                                                              VerticalAlignment="Center"
                                                              IsHitTestVisible="False"
                                                              Visibility="Collapsed"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                                                    </Trigger>
                                                    <Trigger Property="Text" Value="{x:Null}">
                                                        <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <!-- Transcribing loader — shown over the text box while the
                             final speech-to-text pass runs after recording stops.
                             Same background as the bar so it blends seamlessly. -->
                        <Border x:Name="TranscribingOverlay"
                                Grid.Column="1"
                                Background="{DynamicResource SecondaryBackgroundBrush}"
                                Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal"
                                        FlowDirection="RightToLeft"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Margin="12,0">
                                <Ellipse Width="16" Height="16"
                                         Stroke="{StaticResource AccentGreenBrush}"
                                         StrokeThickness="2.4"
                                         StrokeDashArray="3.4 2.2"
                                         StrokeDashCap="Round"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform x:Name="TranscribingSpinnerRotate" Angle="0"/>
                                    </Ellipse.RenderTransform>
                                    <Ellipse.Triggers>
                                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="TranscribingSpinnerRotate"
                                                                     Storyboard.TargetProperty="Angle"
                                                                     From="0" To="360"
                                                                     Duration="0:0:0.9"
                                                                     RepeatBehavior="Forever"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>
                                <TextBlock Text="מתמלל את ההקלטה..."
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="14"
                                           FontFamily="Segoe UI"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Bottom Action Buttons -->
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="AnalyzeDrawingButton"
                            Grid.Column="0"
                            Style="{StaticResource ActionButtonStyle}"
                            Margin="0,0,4,0"
                            Click="AnalyzeDrawingButton_Click"
                            IsEnabled="False"
                            ToolTip="ניתוח השרטוט הפעיל והצגת דו״ח AI">
                        <Grid FlowDirection="RightToLeft">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="AnalyzeDrawingLabel" Grid.Column="0"
                                       Text="מתחבר..."
                                       VerticalAlignment="Center" HorizontalAlignment="Center"
                                       Margin="6,0,6,0" TextTrimming="CharacterEllipsis"/>
                            <Border Grid.Column="1" Width="30" Height="30" CornerRadius="9"
                                    Background="{StaticResource GreenTintBrush}"
                                    BorderBrush="{StaticResource GreenTintBorderBrush}" BorderThickness="1">
                                <Path Data="{StaticResource IconFileText}" Stretch="Uniform" Width="16" Height="16"
                                      Stroke="{StaticResource AccentGreenDarkBrush}" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Button>

                    <Button x:Name="AnalyzeLayersButton"
                            Grid.Column="1"
                            Style="{StaticResource ActionButtonStyle}"
                            Margin="4,0"
                            Click="AnalyzeLayersButton_Click"
                            ToolTip="ניתוח שכבות או קובץ SHP">
                        <Grid FlowDirection="RightToLeft">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="שכבות / SHP"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"
                                       Margin="6,0,6,0" TextTrimming="CharacterEllipsis"/>
                            <Border Grid.Column="1" Width="30" Height="30" CornerRadius="9"
                                    Background="{StaticResource GreenTintBrush}"
                                    BorderBrush="{StaticResource GreenTintBorderBrush}" BorderThickness="1">
                                <Path Data="{StaticResource IconLayers}" Stretch="Uniform" Width="16" Height="16"
                                      Stroke="{StaticResource AccentGreenDarkBrush}" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Button>

                    <Button x:Name="ApplyFixesButton"
                            Grid.Column="2"
                            Style="{StaticResource ActionButtonStyle}"
                            Margin="4,0,0,0"
                            Click="ApplyFixesButton_Click"
                            ToolTip="ביצוע תיקונים על סמך ניתוח השרטוט">
                        <Grid FlowDirection="RightToLeft">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="תיקונים"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"
                                       Margin="6,0,6,0" TextTrimming="CharacterEllipsis"/>
                            <Border Grid.Column="1" Width="30" Height="30" CornerRadius="9"
                                    Background="{StaticResource GreenTintBrush}"
                                    BorderBrush="{StaticResource GreenTintBorderBrush}" BorderThickness="1">
                                <Path Data="{StaticResource IconPencil}" Stretch="Uniform" Width="16" Height="16"
                                      Stroke="{StaticResource AccentGreenDarkBrush}" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Button>
                </Grid>

                <!-- Credit Line -->
                <TextBlock Text="מהוד הנדסה © 2026"
                          Foreground="{StaticResource SecondaryTextBrush}"
                          FontSize="10"
                          HorizontalAlignment="Left"
                          Margin="0,10,0,0"
                          FlowDirection="RightToLeft"/>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
