<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Mahod Civil Delivery as a SEPARATE tool (not part of MahodAI): the same Core sources as
    ..\..\MahodAI.CivilDelivery.Core, compiled under an assembly name no MahodAI build uses, so
    the two tools can load side by side in one Civil 3D process whatever version of MahodAI is
    installed. Zero Autodesk dependencies (directive §19) — unchanged.
  -->
  <PropertyGroup>
    <TargetFramework>$(AutoCADTargetFramework)</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Mahod.CivilDelivery.Core</AssemblyName>
    <RootNamespace>MahodAI.CivilDelivery</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Version>$(MahodCivilDeliveryVersion)</Version>
    <Product>Mahod Civil Delivery Core</Product>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\MahodAI.CivilDelivery.Core\**\*.cs"
             Exclude="..\..\MahodAI.CivilDelivery.Core\bin\**;..\..\MahodAI.CivilDelivery.Core\obj\**"
             Link="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Mahod.CivilDelivery.Tests" />
    <InternalsVisibleTo Include="Mahod.CivilDelivery.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ExcelDataReader" Version="3.8.0" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
    <!-- v4.5 BoQ hatch-overlap estimates (BoqNoteAnalysis); the same 2.6.0 the bundle already ships for the plugin -->
    <PackageReference Include="NetTopologySuite" Version="2.6.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\MahodAI.CivilDelivery.Core\Estimate\PriceBooks\nti-unified-2026-07.xls"
                      LogicalName="Mahod.CivilDelivery.PriceBooks.nti-unified-2026-07.xls" />
    <!-- Same ruleset resource name as the MahodAI Core build (BoqRuleset.EmbeddedResource6422). -->
    <EmbeddedResource Include="..\..\MahodAI.CivilDelivery.Core\Estimate\CorridorBoq\rulesets\6422_corridor_v1.json"
                      LogicalName="MahodAI.CivilDelivery.Estimate.CorridorBoq.rulesets.6422_corridor_v1.json" />
    <EmbeddedResource Include="..\..\MahodAI.CivilDelivery.Core\Estimate\BoqRulesV2\rulesets\6422_v2.json"
                      LogicalName="MahodAI.CivilDelivery.Estimate.BoqRulesV2.rulesets.6422_v2.json" />
  </ItemGroup>

</Project>
