<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared Civil Delivery contracts + the headless estimate service.
       HARD RULE (directive §19): zero Autodesk dependencies in this assembly —
       it must be reusable by future non-Civil data producers unchanged. -->
  <PropertyGroup>
    <TargetFramework>$(AutoCADTargetFramework)</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Ships beside the host plugin and participates in candidate identity. -->
    <Version>1.3.81</Version>
    <FileVersion>1.3.81.0</FileVersion>
    <AssemblyVersion>1.3.81.0</AssemblyVersion>
    <Product>Mahod Civil Delivery Core</Product>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MahodAI.Civil3D.Plugin.Tests" />
    <InternalsVisibleTo Include="MahodAI.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
    <!-- v4.5 BoQ hatch-overlap estimates (BoqNoteAnalysis); the same 2.6.0 the bundle already ships for the plugin -->
    <PackageReference Include="NetTopologySuite" Version="2.6.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- BoQ rules v2: the first ruleset (project 6422) ships inside Core (BoqRuleset.LoadEmbedded6422). -->
    <EmbeddedResource Include="Estimate\CorridorBoq\rulesets\6422_corridor_v1.json"
                      LogicalName="MahodAI.CivilDelivery.Estimate.CorridorBoq.rulesets.6422_corridor_v1.json" />
    <EmbeddedResource Include="Estimate\BoqRulesV2\rulesets\6422_v2.json"
                      LogicalName="MahodAI.CivilDelivery.Estimate.BoqRulesV2.rulesets.6422_v2.json" />
  </ItemGroup>

</Project>
