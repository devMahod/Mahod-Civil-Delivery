<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(AutoCADTargetFramework)</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.2" PrivateAssets="all" />
    <ProjectReference Include="../MahodAI.CivilDelivery.Core/MahodAI.CivilDelivery.Core.csproj" Condition="'$(SaveGuidanceCoreAssembly)' == ''" />
    <!-- Focused isolated runs may use a pinned, already-built Core without rebuilding shared source. -->
    <Reference Include="Mahod.CivilDelivery.Core" Condition="'$(SaveGuidanceCoreAssembly)' != ''">
      <HintPath>$(SaveGuidanceCoreAssembly)</HintPath>
      <Private>true</Private>
    </Reference>
    <Compile Include="../MahodAI.Civil3D.Plugin/CivilDelivery/UI/CivilDeliveryControl.SaveGuidance.cs" Link="Production/CivilDeliveryControl.SaveGuidance.cs" />
    <Compile Include="../MahodAI.Civil3D.Plugin/CivilDelivery/UI/CivilDeliveryControl.DrawingSaveContext.cs" Link="Production/CivilDeliveryControl.DrawingSaveContext.cs" />
    <Compile Include="../MahodAI.Civil3D.Plugin/CivilDelivery/UI/RtlMessageBox.cs" Link="Production/RtlMessageBox.cs" />
    <Compile Include="../MahodAI.Civil3D.Plugin/CivilDelivery/UI/DrawingScopedNotice.cs" Link="Production/DrawingScopedNotice.cs" />
    <Compile Include="../MahodAI.Civil3D.Plugin/CivilDelivery/Commands/CivilDeliveryCommandNames.cs" Link="Production/CivilDeliveryCommandNames.cs" />
    <Compile Include="SaveGuidanceHostShims.cs" />
    <Compile Include="SaveGuidanceCommandLifecycleTests.cs" />
    <Compile Include="DrawingSaveContextLifecycleTests.cs" />
    <Compile Include="SaveGuidanceBoundaryAdapterTests.cs" />
  </ItemGroup>
</Project>
